# Netlify redirects for Rain City Kitchen & Bath
# Format: <from> <to> <status>
# https://docs.netlify.com/routing/redirects/

# ─── SEO: prevent .html duplicate URLs ───
# Astro is built with build.format: 'file', which produces /about.html, /contact.html, etc.
# Without these rules, Google sees /about AND /about.html as two URLs serving the same content
# and treats it as duplicate content. The 301 forces the .html variant to the canonical clean URL.

/index.html                            /                                301!
/about.html                            /about                           301!
/contact.html                          /contact                         301!
/our-services.html                     /our-services                    301!
/our-projects.html                     /our-projects                    301!
# NOTE: Netlify does not support an asterisk in the middle of a path
# (/our-projects/*.html never matches). Per-project .html rules are
# generated from Sanity slugs and appended to dist/_redirects at build
# time by the project-html-redirects hook in astro.config.mjs.
/kitchen-cabinets.html                 /kitchen-cabinets                301!
/kitchen-countertops.html              /kitchen-countertops             301!
/bathroom-remodel.html                 /bathroom-remodel                301!
/thanks.html                           /thanks                          301!

# ─── SEO: serve sitemap at the standard /sitemap.xml path ───
# @astrojs/sitemap hardcodes the output filename to /sitemap-index.xml and there's
# no option to rename it. Use a Netlify rewrite (status 200, not 301) so the
# canonical sitemap URL becomes the standard /sitemap.xml that crawlers and SEO
# tools expect by convention. /sitemap-index.xml stays accessible too in case
# anything has it cached. The child sitemap-0.xml is referenced from inside the
# index file and is the standard way sitemap index files work.
/sitemap.xml                /sitemap-index.xml         200
