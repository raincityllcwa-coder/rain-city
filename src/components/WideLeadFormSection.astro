<section class="w-full py-12 md:py-16 lg:py-20 bg-[#f7f6f1]">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8">
    <div class="bg-white rounded-[20px] p-8 md:p-12 shadow-lg">
      <div class="max-w-[800px] mx-auto">
        <h2 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[32px] text-black text-center mb-3">Book Your Free Consultation</h2>
        <p class="font-['Montserrat'] text-[16px] md:text-[18px] text-[#404040] text-center mb-8">Fill out the form below and our team will reach out to schedule your free consultation.</p>
        <form class="flex flex-col gap-6" data-form="wide">
          <div class="hp-field" aria-hidden="true">
            <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <input type="text" name="name" placeholder="Your Name" required class="bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[56px] px-[18px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5] transition-colors" />
            <input type="tel" name="phone" placeholder="(___) ___-____" required pattern="[0-9()\-\s+]{10,}" minlength="10" title="Enter a valid phone number" class="bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[56px] px-[18px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5] transition-colors" />
          </div>
          <select name="bestTime" class="besttime-light bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[56px] px-[18px] font-['Montserrat'] text-[16px] focus:outline-none focus:border-[#007ec5] transition-colors">
            <option value="">Best time to call (optional)</option>
            <option value="Morning">Morning</option>
            <option value="Afternoon">Afternoon</option>
            <option value="Evening">Evening</option>
            <option value="Anytime">Anytime</option>
          </select>
          <textarea name="details" required placeholder="Tell us about your project" class="bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[120px] px-[18px] py-[16px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] resize-none focus:outline-none focus:border-[#007ec5] transition-colors"></textarea>
          <button type="submit" class="bg-[#051e2a] border border-[#051e2a] rounded-[5px] h-[55px] font-['Montserrat'] font-bold text-[16px] text-white hover:bg-[#0a2e3f] transition-colors">Book a Free Consultation</button>
        </form>
      </div>
    </div>
  </div>
</section>
