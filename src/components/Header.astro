---
import { getSite } from '@/lib/site';
import imgTelephoneIcon from "@/assets/a7886c55528f6e197789a4b7d647dd63cdc250d2.webp";
import { getNavigation, resolveNavItems } from "@/lib/navigation";

// Services dropdown groups from Sanity (Navigation document). With no groups
// configured the header keeps the plain "Our Services" link.
const nav = await getNavigation();
const groups: { group: string; items: { label: string; href: string }[] }[] = [];
for (const g of nav?.servicesMenu || []) {
  const items = await resolveNavItems(g?.items);
  if (items.length > 0) groups.push({ group: g.group || "", items });
}
const hasDropdown = groups.length > 0;

// Service Areas dropdown: one flat list of city pages from Sanity. Empty list
// means no menu item. Splits into up to three columns of eight as cities grow.
const cities = await resolveNavItems(nav?.citiesMenu);
const hasCities = cities.length > 0;
const colCount = Math.min(3, Math.max(1, Math.ceil(cities.length / 8)));
const perCol = Math.ceil(cities.length / colCount) || 1;
const cityCols = Array.from({ length: colCount }, (_, i) => cities.slice(i * perCol, (i + 1) * perCol)).filter((c) => c.length > 0);
const site = await getSite();
---

<!-- Top Navigation - Desktop Only -->
<div class="bg-[#f3f3f3] w-full hidden md:block">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8 h-[50px] flex items-center justify-end">
    <div class="flex items-center gap-[15px]">
      <img src={imgTelephoneIcon.src} alt="Call us" class="size-[22px] object-cover" width="22" height="22" />
      <p class="font-['Montserrat'] font-medium text-[14px] md:text-[16px] text-black whitespace-nowrap">Call Us: {site.phone}</p>
    </div>
  </div>
</div>

<!-- Main Header -->
<div class="bg-white w-full z-50">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8 py-3 md:py-[25px] md:pb-[28px]">
    <div class="flex items-center justify-between">
      <a href="/" class="flex flex-col gap-[2px] md:gap-[7px] shrink-0">
        <p class="font-['Playfair_Display'] font-bold text-[24px] md:text-[30px] text-[#051e2a] uppercase leading-[30px] md:leading-tight whitespace-nowrap">Rain City</p>
        <div class="h-[1px] bg-[#051e2a] opacity-40 min-w-[120px] md:w-full"></div>
        <p class="font-['Montserrat'] font-normal text-[16px] md:text-[20px] text-[#051e2a] leading-[20px] md:leading-tight whitespace-nowrap">Kitchen & Bath</p>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex gap-[29px] items-center text-[18px] text-black">
        <a href="/" class="font-['Montserrat'] font-medium hover:text-[#007ec5] transition-colors">Home</a>
        {hasDropdown ? (
          <div class="relative group">
            <a href="/our-services" class="font-['Montserrat'] font-normal hover:text-[#007ec5] transition-colors inline-flex items-center gap-1" aria-haspopup="true">Our Services <span aria-hidden="true" class="text-[12px]">▾</span></a>
            <div class="absolute left-0 top-full pt-3 hidden group-hover:block group-focus-within:block z-50">
              <div class="bg-white shadow-xl border border-gray-100 rounded-[5px] p-6 flex gap-10 min-w-max">
                {groups.map((g) => (
                  <div class="flex flex-col gap-2 min-w-[180px]">
                    {g.group && <p class="font-['Montserrat'] font-semibold text-[13px] uppercase tracking-wide text-gray-500 mb-1">{g.group}</p>}
                    {g.items.map((l) => (
                      <a href={l.href} class="font-['Montserrat'] font-normal text-[15px] text-black hover:text-[#007ec5] transition-colors whitespace-nowrap">{l.label}</a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href="/our-services" class="font-['Montserrat'] font-normal hover:text-[#007ec5] transition-colors">Our Services</a>
        )}
        {hasCities && (
          <div class="relative group">
            <button type="button" class="font-['Montserrat'] font-normal hover:text-[#007ec5] transition-colors inline-flex items-center gap-1" aria-haspopup="true">Service Areas <span aria-hidden="true" class="text-[12px]">▾</span></button>
            <div class="absolute left-0 top-full pt-3 hidden group-hover:block group-focus-within:block z-50">
              <div class="bg-white shadow-xl border border-gray-100 rounded-[5px] p-6 flex gap-10 min-w-max">
                {cityCols.map((col) => (
                  <div class="flex flex-col gap-2 min-w-[180px]">
                    {col.map((l) => (
                      <a href={l.href} class="font-['Montserrat'] font-normal text-[15px] text-black hover:text-[#007ec5] transition-colors whitespace-nowrap">{l.label}</a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
        <a href="/our-projects" class="font-['Montserrat'] font-normal hover:text-[#007ec5] transition-colors">Projects</a>
        <a href="/about" class="font-['Montserrat'] font-normal hover:text-[#007ec5] transition-colors">About Us</a>
        <a href="/contact" class="font-['Montserrat'] font-normal hover:text-[#007ec5] transition-colors">Contact</a>
      </nav>

      <!-- Mobile Phone & Menu -->
      <div class="lg:hidden flex items-center gap-3">
        <a href={site.phoneHref} class="flex items-center">
          <img src={imgTelephoneIcon.src} alt="Call us" class="w-[22px] h-[22px] object-cover" width="22" height="22" />
        </a>
        <button id="burger-btn" class="flex flex-col gap-[5px] w-6 h-6 justify-center items-center" aria-label="Toggle menu">
          <span class="burger-line w-6 h-[2px] bg-black transition-all"></span>
          <span class="burger-line w-6 h-[2px] bg-black transition-opacity"></span>
          <span class="burger-line w-6 h-[2px] bg-black transition-all"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <nav id="mobile-nav" class="lg:hidden mt-6 flex-col gap-4 pb-4 border-t pt-4 hidden">
      <a href="/" class="font-['Montserrat'] font-medium text-[16px] text-black hover:text-[#007ec5] transition-colors">Home</a>
      <a href="/our-services" class="font-['Montserrat'] font-normal text-[16px] text-black hover:text-[#007ec5] transition-colors">Our Services</a>
      {hasDropdown && groups.map((g) => (
        <div class="pl-4 flex flex-col gap-2">
          {g.group && <p class="font-['Montserrat'] font-semibold text-[12px] uppercase tracking-wide text-gray-500">{g.group}</p>}
          {g.items.map((l) => (
            <a href={l.href} class="font-['Montserrat'] font-normal text-[15px] text-black hover:text-[#007ec5] transition-colors">{l.label}</a>
          ))}
        </div>
      ))}
      {hasCities && (
        <>
          <p class="font-['Montserrat'] font-normal text-[16px] text-black">Service Areas</p>
          <div class="pl-4 flex flex-col gap-2">
            {cities.map((l) => (
              <a href={l.href} class="font-['Montserrat'] font-normal text-[15px] text-black hover:text-[#007ec5] transition-colors">{l.label}</a>
            ))}
          </div>
        </>
      )}
      <a href="/our-projects" class="font-['Montserrat'] font-normal text-[16px] text-black hover:text-[#007ec5] transition-colors">Projects</a>
      <a href="/about" class="font-['Montserrat'] font-normal text-[16px] text-black hover:text-[#007ec5] transition-colors">About Us</a>
      <a href="/contact" class="font-['Montserrat'] font-normal text-[16px] text-black hover:text-[#007ec5] transition-colors">Contact</a>
    </nav>
  </div>
</div>

<script>
  const btn = document.getElementById('burger-btn');
  const nav = document.getElementById('mobile-nav');
  const lines = document.querySelectorAll('.burger-line');

  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    nav?.classList.toggle('flex', open);
    if (lines[0]) lines[0].classList.toggle('rotate-45', open);
    if (lines[0]) lines[0].classList.toggle('translate-y-[7px]', open);
    if (lines[1]) lines[1].classList.toggle('opacity-0', open);
    if (lines[2]) lines[2].classList.toggle('-rotate-45', open);
    if (lines[2]) lines[2].classList.toggle('-translate-y-[7px]', open);
  });
</script>
