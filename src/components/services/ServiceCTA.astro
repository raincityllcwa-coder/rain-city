<section class="w-full py-12 md:py-16 lg:py-20 bg-[#f7f6f1]">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div>
        <h2 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[32px] text-black mb-4">Ready to Get Started?</h2>
        <p class="font-['Montserrat'] text-[16px] md:text-[18px] text-[#404040] mb-6">Transform your kitchen or bathroom with Rain City Kitchen & Bath.</p>
        <div class="space-y-3">
          <div class="flex items-center gap-3"><div class="w-2 h-2 bg-[#007ec5] rounded-full"></div><p class="font-['Montserrat'] text-[15px] text-[#404040]">Free consultation & quote</p></div>
          <div class="flex items-center gap-3"><div class="w-2 h-2 bg-[#007ec5] rounded-full"></div><p class="font-['Montserrat'] text-[15px] text-[#404040]">Expert design advice</p></div>
          <div class="flex items-center gap-3"><div class="w-2 h-2 bg-[#007ec5] rounded-full"></div><p class="font-['Montserrat'] text-[15px] text-[#404040]">Professional installation</p></div>
        </div>
      </div>
      <div class="bg-white p-6 md:p-8 rounded-[20px] shadow-xl">
        <h3 class="font-['Playfair_Display'] font-semibold text-[22px] md:text-[24px] text-black mb-3 text-center">Get Started Today</h3>
        <p class="font-['Montserrat'] text-[15px] text-[#404040] mb-6 text-center">Contact us for a free consultation and quote.</p>
        <form class="space-y-4" data-form="cta">
          <div class="hp-field" aria-hidden="true">
            <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
          <input type="text" name="name" placeholder="Your Name" required class="w-full px-4 py-3 bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5]" />
          <input type="email" name="email" placeholder="Your Email" required class="w-full px-4 py-3 bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5]" />
          <input type="tel" name="phone" placeholder="(___) ___-____" required pattern="[0-9()\-\s+]{10,}" minlength="10" title="Enter a valid phone number" class="w-full px-4 py-3 bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5]" />
          <button type="submit" class="w-full h-[50px] bg-[#051e2a] text-white font-['Montserrat'] font-bold text-[16px] rounded-[5px] hover:bg-[#0a2e3f] transition-colors">Book a Free Consultation</button>
        </form>
      </div>
    </div>
  </div>
</section>
