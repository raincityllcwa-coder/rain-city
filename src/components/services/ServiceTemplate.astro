---
// Service page template (Kitchen Remodel, Bathroom Remodeling and their
// sub-pages): full-width hero with the form strip under it, then the blocks
// in the order set on the page (sectionOrder), backgrounds alternating
// white / cream with the reviews block on mist, then the SEO text and the
// links to the other service pages. Every text and photo comes from the
// servicePage document; shared texts from Shared Sections (copy-shared).
import { urlFor } from '../../lib/sanity';
import { getDocById } from '../../lib/queries';
import { getAllPages, bodyToHtml, rootService, type PageDoc } from '../../lib/pages';
import WhyChooseUsSection from '../WhyChooseUsSection.astro';
import OurProcessSection from '../OurProcessSection.astro';
import ServiceAreaSection from '../ServiceAreaSection.astro';
import ReviewsGridSection from './ReviewsGridSection.astro';
import ProjectsSection from '../ProjectsSection.astro';
import WideLeadFormSection from '../WideLeadFormSection.astro';

interface Props {
  page: PageDoc;
  site: any;
  heroSrc: string | null;
  heroAlt?: string;
  reviews: any[];
  projects: any[];
}
const { page, site, heroSrc, heroAlt, reviews, projects } = Astro.props;

const shared = (await getDocById('copy-shared')) || {};
const T = {
  formHeading: shared.svcFormHeading || 'Book Your Free Consultation',
  formNote: shared.svcFormNote || 'Free in-home visit. Written estimate after the visit.',
  button: shared.svcButtonLabel || 'Book a Free Consultation',
  finalHeading: shared.svcFinalHeading || 'Ready to start? Book Your Free Consultation',
  finalText: shared.svcFinalText || `Send the form or call ${site.phone}. We come to your home with the samples, and a written estimate follows the visit.`,
  before: shared.svcBeforeLabel || 'Before',
  after: shared.svcAfterLabel || 'After',
  galleryLink: shared.svcGalleryLink || 'All projects',
  linksKitchen: shared.svcLinksKitchen || 'Kitchen services',
  linksBathroom: shared.svcLinksBathroom || 'Bathroom services',
};
const room = page.branch === 'bathroom' ? 'bathroom' : 'kitchen';

const img = (image: any, w: number, h: number) =>
  image?.asset ? urlFor(image).width(w).height(h).fit('crop').format('webp').quality(80).url() : '';

// Intro carousel
const slides = (page.sliderPhotos || []).filter((p: any) => p?.asset).map((p: any) => ({ src: img(p, 1000, 750), alt: p.alt || page.title }));
const hasIntro = Boolean(page.introTitle || page.introParagraphs?.length || slides.length);

// What is included
const included = (page.includedItems || []).filter((i) => i?.title);

// Benefits
const benefits = (page.benefits || []).filter((b) => b?.title);

// Unique block
const ub = page.uniqueBlock;
const hasUnique = Boolean(ub && (ub.heading || (ub.items && ub.items.length)));

// Extra text block
const bodyHtml = bodyToHtml(page.body);

// Proof: before/after or gallery
const ba = page.beforeAfter;
const hasBeforeAfter = page.proofMode === 'project' && Boolean(ba?.beforePhoto?.asset && ba?.afterPhoto?.asset);
const gallery = (page.gallery || []).filter((g: any) => g?.asset);
const hasGallery = page.proofMode === 'gallery' && gallery.length > 0;
const galleryBig = page.galleryStyle === 'big3';

// FAQ
const faqs = page.faqs || [];
const seoHtml = bodyToHtml(page.seoText);

// Links to the other service pages, grouped by branch, current page marked.
const all = await getAllPages();
const services = all.filter((p) => p.pageType === 'service' && (!p.noindex || p._id === page._id));
const rootOrder = (p: PageDoc) => rootService(p).path + (p.menuChain.length ? '/' + p.slug : '');
const kitchenLinks = services.filter((p) => (p.branch || 'kitchen') !== 'bathroom').sort((a, b) => rootOrder(a).localeCompare(rootOrder(b)));
const bathroomLinks = services.filter((p) => p.branch === 'bathroom').sort((a, b) => rootOrder(a).localeCompare(rootOrder(b)));

// Block order and backgrounds
const DEFAULT_ORDER = ['intro', 'included', 'benefits', 'why', 'process', 'reviews', 'proof', 'faq', 'area', 'final'];
const order = (page.sectionOrder && page.sectionOrder.length ? page.sectionOrder : DEFAULT_ORDER).filter((b) => {
  if (b === 'intro') return hasIntro;
  if (b === 'included') return included.length > 0;
  if (b === 'benefits') return benefits.length > 0;
  if (b === 'unique') return hasUnique;
  if (b === 'text') return Boolean(bodyHtml);
  if (b === 'why') return page.showWhyChooseUs !== false;
  if (b === 'process') return page.showProcess !== false;
  if (b === 'reviews') return page.showReviews !== false && reviews.length > 0;
  if (b === 'projects') return page.showProjects !== false && projects.length > 0;
  if (b === 'proof') return hasBeforeAfter || hasGallery;
  if (b === 'faq') return faqs.length > 0;
  if (b === 'area') return page.showServiceArea !== false;
  if (b === 'final') return page.showLeadForm !== false;
  return false;
});
const bgOf = (i: number, b: string) => (b === 'reviews' ? 'bg-[#f1f3f7]' : i % 2 === 0 ? 'bg-white' : 'bg-[#f7f6f1]');

const H2 = "font-['Playfair_Display'] font-bold text-[28px] md:text-[32px] text-black";
const H3 = "font-['Playfair_Display'] font-bold text-[20px] md:text-[21px] text-[#051e2a] leading-snug";
const P = "font-['Montserrat'] text-[16px] md:text-[17px] text-[#404040] leading-relaxed";
const P15 = "font-['Montserrat'] text-[15px] md:text-[15.5px] text-[#404040] leading-relaxed";
const CAP = "font-['Montserrat'] text-[13px] text-[#898989] mt-2";
const BTN = "inline-flex shrink-0 whitespace-nowrap items-center justify-center bg-[#007ec5] hover:bg-[#006ba8] text-white font-['Montserrat'] font-bold text-[16px] md:text-[17px] h-[55px] px-8 rounded-[5px] transition-colors";
const FIELD = "min-w-0 w-full bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[56px] px-[18px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5] transition-colors";
---

<!-- Hero -->
<section class="relative w-full overflow-hidden">
  <div class="absolute inset-0">
    {heroSrc && <img src={heroSrc} alt={heroAlt || page.title} class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />}
    <div class="absolute inset-0 bg-gradient-to-t from-[#051e2a]/[0.92] via-[#051e2a]/[0.68] lg:via-[#051e2a]/[0.45] to-[#051e2a]/[0.40] lg:to-[#051e2a]/[0.10]"></div>
  </div>
  <div class="relative max-w-[1150px] mx-auto px-4 md:px-8 min-h-[380px] md:min-h-[480px] lg:min-h-[540px] flex flex-col justify-end pb-20 md:pb-24 pt-16">
    <h1 class="font-['Playfair_Display'] font-semibold text-[32px] md:text-[44px] lg:text-[48px] leading-[1.15] text-white max-w-[820px]" style="text-shadow: 0 1px 4px rgba(0,0,0,0.35);">{page.title}</h1>
    {page.subtitle && <p class="font-['Montserrat'] text-[16.5px] md:text-[19px] text-white/95 mt-4 max-w-[680px] leading-relaxed">{page.subtitle}</p>}
  </div>
</section>

<!-- Form strip -->
<section id="book" class="w-full bg-[#f7f6f1] pb-10 md:pb-12 scroll-mt-4">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8">
    <div class="relative z-10 -mt-12 md:-mt-14 bg-white rounded-[20px] shadow-xl p-6 md:p-8 grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-5 lg:gap-10 items-center">
      <div>
        <h2 class="font-['Playfair_Display'] font-semibold text-[22px] md:text-[24px] text-black leading-tight">{T.formHeading}</h2>
        <p class="font-['Montserrat'] text-[14px] text-[#898989] mt-2">{T.formNote}</p>
      </div>
      <form class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto] gap-4" data-form="strip">
        <div class="hp-field" aria-hidden="true"><label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
        <input type="text" name="name" placeholder="Your Name" aria-label="Your name" autocomplete="name" required class={FIELD} />
        <input type="tel" name="phone" placeholder="(___) ___-____" aria-label="Phone number" autocomplete="tel" inputmode="tel" required pattern="[0-9()\-\s+]{10,}" minlength="10" title="Enter a valid phone number" class={FIELD} />
        <button type="submit" class="sm:col-span-2 lg:col-span-1 bg-[#051e2a] hover:bg-[#0a2e3f] border border-[#051e2a] rounded-[5px] h-[56px] px-7 font-['Montserrat'] font-bold text-[16px] text-white transition-colors whitespace-nowrap">{T.button}</button>
      </form>
    </div>
  </div>
</section>

{order.map((block, i) => {
  const bg = bgOf(i, block);
  if (block === 'intro') return (
    <section class={`w-full py-12 md:py-16 ${bg}`}>
      <div class="max-w-[1150px] mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-8 lg:gap-16 items-center">
        <div>
          {page.introTitle && <h2 class={H2}>{page.introTitle}</h2>}
          {(page.introParagraphs || []).map((t, k) => <p class={`${P} ${k === 0 ? 'mt-5' : 'mt-4'}`}>{t}</p>)}
        </div>
        {slides.length > 0 && (
          <div class="ic-root relative w-full aspect-[4/3] rounded-[5px] overflow-hidden bg-[#f5f5f5]" data-ic-interval="4000">
            {slides.map((s, k) => <img data-ic-slide src={s.src} alt={s.alt} loading={k === 0 ? 'eager' : 'lazy'} style={k === 0 ? 'opacity:1' : 'opacity:0'} class="w-full h-full object-cover absolute inset-0 transition-opacity duration-1000" />)}
          </div>
        )}
      </div>
    </section>
  );
  if (block === 'included') return (
    <section class={`w-full py-12 md:py-16 ${bg}`}>
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        <div class="max-w-[760px]">
          {page.includedHeading && <h2 class={H2}>{page.includedHeading}</h2>}
          {page.includedIntro && <p class={`${P} mt-4`}>{page.includedIntro}</p>}
        </div>
        <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-x-12 border-b border-[#e6e6e6]">
          {included.map((it, k) => (
            <div class="flex gap-5 md:gap-6 py-6 border-t border-[#e6e6e6]">
              {it.photo?.asset && <img src={img(it.photo, 400, 300)} alt={it.photo.alt || it.title} loading="lazy" class="w-[120px] h-[90px] md:w-[168px] md:h-[126px] shrink-0 object-cover rounded-[5px] bg-[#f5f5f5]" />}
              <div class="min-w-0">
                <p class="font-['Montserrat'] font-semibold text-[13px] text-[#898989]">{String(k + 1).padStart(2, '0')}</p>
                <h3 class="font-['Playfair_Display'] font-bold text-[20px] md:text-[22px] text-[#051e2a] mt-1 leading-snug">{it.title}</h3>
                {it.text && <p class={`${P15} mt-2`}>{it.text}</p>}
              </div>
            </div>
          ))}
        </div>
        <div class="mt-8"><a href="#book" class={BTN}>{T.button}</a></div>
      </div>
    </section>
  );
  if (block === 'benefits') return (
    <section class={`w-full py-12 md:py-16 ${bg}`}>
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        {page.benefitsHeading && <h2 class={`${H2} max-w-[760px]`}>{page.benefitsHeading}</h2>}
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {benefits.map((b) => (
            <div class={`${bg === 'bg-white' ? 'bg-[#f7f6f1]' : 'bg-white border border-[#e6e6e6]'} rounded-[5px] p-6 md:p-7 flex flex-col`}>
              <h3 class="font-['Playfair_Display'] font-bold text-[21px] text-[#051e2a] leading-snug">{b.title}</h3>
              {b.text && <p class={`${P15} mt-3`}>{b.text}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  );
  if (block === 'unique' && ub) {
    const items = (ub.items || []).filter((x) => x?.title || x?.text);
    const style = ub.style || 'cols';
    return (
      <section class={`w-full py-12 md:py-16 ${bg}`}>
        <div class="max-w-[1150px] mx-auto px-4 md:px-8">
          <div class="max-w-[760px]">
            {ub.heading && <h2 class={H2}>{ub.heading}</h2>}
            {ub.intro && <p class={`${P} mt-4`}>{ub.intro}</p>}
          </div>
          {style === 'cols' && (
            <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-x-12 border-b border-[#e6e6e6]">
              {items.map((x) => <div class="py-5 border-t border-[#e6e6e6]"><h3 class={H3}>{x.title}</h3>{x.text && <p class={`${P15} mt-2`}>{x.text}</p>}</div>)}
            </div>
          )}
          {style === 'checklist' && (
            <ul class="mt-8 flex flex-col gap-4 max-w-[820px]">
              {items.map((x) => (
                <li class="flex items-start gap-4">
                  <span class="shrink-0 w-[26px] h-[26px] rounded-full bg-[#007ec5] flex items-center justify-center mt-[1px]"><svg class="w-[14px] h-[14px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 7"></path></svg></span>
                  <p class="font-['Montserrat'] text-[16px] md:text-[17px] text-black leading-relaxed">{x.text || x.title}</p>
                </li>
              ))}
            </ul>
          )}
          {style === 'compare' && (
            <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
              {items.map((x) => <div class="bg-white border border-[#e6e6e6] rounded-[5px] p-6 md:p-7"><h3 class={H3}>{x.title}</h3>{x.text && <p class={`${P15} mt-3`}>{x.text}</p>}</div>)}
            </div>
          )}
          {style === 'steps' && (
            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
              {items.map((x, k) => (
                <div class="flex gap-5">
                  <span class="font-['Playfair_Display'] font-bold text-[34px] leading-none text-[#051e2a] shrink-0 w-[34px]">{k + 1}</span>
                  <div><h3 class={H3}>{x.title}</h3>{x.text && <p class={`${P15} mt-2`}>{x.text}</p>}</div>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    );
  }
  if (block === 'text') return (
    <section class={`w-full py-12 md:py-16 ${bg}`}>
      <div class="max-w-[1150px] mx-auto px-4 md:px-8"><div class="max-w-[860px]" set:html={bodyHtml} /></div>
    </section>
  );
  if (block === 'why') return <WhyChooseUsSection bg={bg} />;
  if (block === 'process') return <OurProcessSection bg={bg} />;
  if (block === 'reviews') return <ReviewsGridSection reviews={reviews} bg={bg} />;
  if (block === 'projects') return <ProjectsSection projects={projects} />;
  if (block === 'proof' && hasBeforeAfter) return (
    <section class={`w-full py-12 md:py-16 ${bg}`}>
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        {page.proofHeading && <h2 class={`${H2} max-w-[760px]`}>{page.proofHeading}</h2>}
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          <figure class="relative">
            <img src={img(ba!.beforePhoto, 900, 675)} alt={ba!.beforePhoto.alt || T.before} loading="lazy" class="w-full aspect-[4/3] object-cover rounded-[5px] bg-[#f5f5f5]" />
            <figcaption class="absolute top-3 left-3 bg-white/95 rounded-full px-3 py-1 font-['Montserrat'] font-semibold text-[13px] text-black">{T.before}</figcaption>
          </figure>
          <figure class="relative">
            <img src={img(ba!.afterPhoto, 900, 675)} alt={ba!.afterPhoto.alt || T.after} loading="lazy" class="w-full aspect-[4/3] object-cover rounded-[5px] bg-[#f5f5f5]" />
            <figcaption class="absolute top-3 left-3 bg-white/95 rounded-full px-3 py-1 font-['Montserrat'] font-semibold text-[13px] text-black">{T.after}</figcaption>
          </figure>
        </div>
        {(ba!.beforeText || ba!.afterText) && (
          <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12 max-w-[1000px]">
            {ba!.beforeText && <p class={P}>{ba!.beforeText}</p>}
            <p class={P}>{ba!.afterText} {ba!.projectSlug && <a href={`/our-projects/${ba!.projectSlug}`} class="text-[#007ec5] font-semibold hover:underline">{ba!.linkLabel || 'Read the full case study'}</a>}</p>
          </div>
        )}
      </div>
    </section>
  );
  if (block === 'proof' && hasGallery) return (
    <section class={`w-full py-12 md:py-16 ${bg}`}>
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          {page.proofHeading && <h2 class={H2}>{page.proofHeading}</h2>}
          <a href="/our-projects" class="font-['Montserrat'] text-[#007ec5] font-semibold hover:underline text-[15px]">{T.galleryLink}</a>
        </div>
        <div class={`mt-8 grid ${galleryBig ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-2 md:grid-cols-3'} gap-4 md:gap-6`}>
          {(galleryBig ? gallery.slice(0, 3) : gallery.slice(0, 6)).map((g: any) => (
            <figure>
              <img src={galleryBig ? img(g, 1000, 667) : img(g, 700, 525)} alt={g.alt || page.title} loading="lazy" class={`w-full ${galleryBig ? 'aspect-[3/2]' : 'aspect-[4/3]'} object-cover rounded-[5px] bg-[#f5f5f5]`} />
              {g.alt && <figcaption class={CAP}>{g.alt}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  );
  if (block === 'faq') return (
    <section class={`w-full py-12 md:py-16 ${bg}`}>
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        <h2 class={H2}>{page.faqHeading || `Questions homeowners ask before a ${room} project`}</h2>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 md:gap-y-10">
          {faqs.map((f) => <div><h3 class="font-['Playfair_Display'] font-bold text-[20px] text-[#051e2a] leading-snug">{f.question}</h3><p class={`${P15} mt-3`}>{f.answer}</p></div>)}
        </div>
      </div>
    </section>
  );
  if (block === 'area') return <ServiceAreaSection bg={bg} linkCities={true} />;
  if (block === 'final') return <WideLeadFormSection heading={T.finalHeading} text={T.finalText} placeholder={`Tell us about your ${room}`} bg={bg} bordered={true} />;
  return null;
})}

{seoHtml && (
  <section class="w-full py-12 md:py-16 border-t border-[#e6e6e6] bg-white">
    <div class="max-w-[1150px] mx-auto px-4 md:px-8">
      {page.seoTextTitle && <h2 class={H2}>{page.seoTextTitle}</h2>}
      <div class="mt-6 max-w-[900px] service-seo" set:html={seoHtml} />
    </div>
  </section>
)}

{page.showAreas !== false && (kitchenLinks.length + bathroomLinks.length > 1) && (
  <section class="w-full py-10 md:py-14 border-t border-[#e6e6e6] bg-white">
    <div class="max-w-[1150px] mx-auto px-4 md:px-8 grid grid-cols-1 sm:grid-cols-2 max-w-[760px] gap-8">
      {[{ title: T.linksKitchen, items: kitchenLinks }, { title: T.linksBathroom, items: bathroomLinks }].filter((c) => c.items.length).map((col) => (
        <div>
          <h3 class="font-['Montserrat'] font-semibold text-[16px] text-black mb-3">{col.title}</h3>
          <ul class="flex flex-col gap-2">
            {col.items.map((p) => (
              <li><a href={p.path} class={`font-['Montserrat'] text-[15px] hover:text-[#007ec5] transition-colors ${p._id === page._id ? 'text-[#007ec5] font-semibold' : 'text-[#404040]'} ${p.menuChain.length ? 'pl-4' : ''}`}>{p.cardTitle || p.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

<style is:global>
  .service-seo h3 { margin-top: 1.25rem; }
</style>

<script is:inline>
  (function () {
    function start(root) {
      var slides = root.querySelectorAll('[data-ic-slide]');
      if (slides.length < 2 || root.dataset.icStarted === '1') return;
      root.dataset.icStarted = '1';
      var ms = parseInt(root.getAttribute('data-ic-interval'), 10) || 4000, i = 0;
      setInterval(function () { slides[i].style.opacity = '0'; i = (i + 1) % slides.length; slides[i].style.opacity = '1'; }, ms);
    }
    function init() { document.querySelectorAll('.ic-root').forEach(start); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
