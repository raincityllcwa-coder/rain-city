---
import { Image } from "astro:assets";
import googleG from "@/assets/badges/google-g.png";
import starIcon from "@/assets/badges/star.png";

interface Props {
  backgroundImage: string;
  title: string;
  subtitle: string;
}
const { backgroundImage, title, subtitle } = Astro.props;
---

<section class="relative w-full min-h-[500px] md:min-h-[630px] flex items-center">
  <div class="absolute inset-0">
    <img src={backgroundImage} alt={`${title} - Rain City Kitchen & Bath`} class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-black/60"></div>
  </div>
  <div class="relative max-w-[1150px] mx-auto px-4 md:px-8 py-8 md:py-[37px] w-full">
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-[100px] items-center justify-between">
      <div class="flex flex-col gap-[12px] md:gap-[15px] w-full lg:w-[441px] text-center lg:text-left">
        <h1 class="font-['Lora'] font-bold text-[28px] md:text-[36px] lg:text-[42px] text-white leading-tight">{title}</h1>
        <p class="font-['Montserrat'] font-normal text-[16px] md:text-[18px] text-white">{subtitle}</p>
        <div class="flex gap-[7px] items-center justify-center lg:justify-start">
          <Image src={googleG} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
          <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
          <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
          <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
          <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
          <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
          <span class="font-['Montserrat'] font-medium text-[16px] text-white/90 ml-2">5.0 (131 reviews)</span>
        </div>
      </div>

      <!-- Form -->
      <div class="bg-white rounded-[20px] w-full lg:max-w-[379px] p-6 md:p-10 shadow-xl">
        <h2 class="font-['Lora'] font-semibold text-[22px] md:text-[28px] text-black text-center mb-5 leading-tight">Book Your Free Consultation</h2>
        <form class="flex flex-col gap-5" data-form="service-hero">
          <input type="text" name="name" placeholder="Your Name" required class="bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[50px] px-[14px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5]" />
          <input type="tel" name="phone" placeholder="(___) ___-____" required pattern="[0-9()\-\s+]{10,}" minlength="10" title="Enter a valid phone number" class="bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[50px] px-[14px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:border-[#007ec5]" />
          <textarea name="details" required placeholder="Tell us about your project" class="bg-[#f5f5f5] border border-[#e6e6e6] rounded-[5px] h-[106px] px-[14px] py-[15px] font-['Montserrat'] text-[16px] text-black placeholder:text-[#898989] resize-none focus:outline-none focus:border-[#007ec5]"></textarea>
          <p class="font-['Montserrat'] font-normal text-[14px] text-[#404040] text-center">A real conversation about your project. No pushy sales calls.</p>
          <button type="submit" class="bg-[#007ec5] border border-[#007ec5] rounded-[5px] h-[50px] font-['Montserrat'] font-bold text-[16px] text-white hover:bg-[#006ba8] transition-colors">Book a Free Consultation</button>
        </form>
        <div class="hidden text-center py-8" data-success="service-hero">
          <p class="font-['Montserrat'] text-[20px] text-[#007ec5] font-semibold">Thank you! We'll contact you soon.</p>
        </div>
      </div>
    </div>
  </div>
</section>
