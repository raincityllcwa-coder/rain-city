---
// Three-up service blocks on /our-services
// Static, no interactivity, no React/JS runtime.
import imgServiceImage from "@/assets/c4e93df24993f176102d516e4e5e7a4fd86822b6.webp";
import imgServiceImage1 from "@/assets/45b63473772ac5eedb2419a124f3a11b4a82ba56.webp";
import imgServiceImage2 from "@/assets/2221dd725ae6402fca45a45bd79869231da67ce7.webp";
import { getDocById } from "@/lib/queries";
import { urlFor } from "@/lib/sanity";

const services = [
  {
    id: "kitchen-cabinets",
    slug: "kitchen-cabinets",
    title: "Kitchen Renovation & Cabinets",
    image: imgServiceImage.src,
    bgColor: "#f7f6f1",
    textColor: "#051e2a",
    description: "Transform your kitchen with custom cabinets. Choose from Shaker, Flat, or custom door styles in a variety of colors and finishes.",
    reverse: false,
  },
  {
    id: "kitchen-countertops",
    slug: "kitchen-countertops",
    title: "Kitchen Countertops",
    image: imgServiceImage1.src,
    bgColor: "#f1f3f7",
    textColor: "#051e2a",
    reverse: true,
    description: "Premium natural stone countertops in dolomite, granite, marble, quartzite, schist, and soapstone. Complete service from templating to installation.",
  },
  {
    id: "bathroom-remodel",
    slug: "bathroom-remodel",
    title: "Bathroom Remodel",
    image: imgServiceImage2.src,
    bgColor: "#f7f6f1",
    textColor: "#051e2a",
    description: "Complete bathroom transformations with premium tile, modern fixtures, and expert craftsmanship.",
    reverse: false,
  },
];

// Card photos are editable in Sanity (Service Page Texts: "Photo on the Our
// Services page card", falling back to that page's hero photo, then to the
// built-in file).
for (const service of services) {
  const doc = await getDocById(`service-${service.id}`);
  const pic = doc?.cardImage?.asset ? doc.cardImage : doc?.heroImage?.asset ? doc.heroImage : null;
  if (pic) {
    (service as any).image = urlFor(pic).width(926).height(760).fit("crop").format("webp").quality(80).url();
    (service as any).imageAlt = pic.alt || service.title;
  }
}
---

<section class="w-full py-16 md:py-20 lg:py-24">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8">
    <div class="flex flex-col gap-20 md:gap-28">
      {services.map((service) => (
        <div id={service.id} class="scroll-mt-20">
          <div class="relative">
            <div class={`flex flex-col ${service.reverse ? 'md:flex-row-reverse' : 'md:flex-row'} gap-6 md:gap-0 items-center`}>
              {/* Image */}
              <a
                href={`/${service.slug}`}
                class="w-full md:w-[463px] h-[280px] md:h-[380px] rounded-[5px] overflow-hidden shrink-0 relative z-10 hover:opacity-95 transition-opacity"
              >
                <img src={service.image} alt={(service as any).imageAlt || service.title} class="w-full h-full object-cover" loading="lazy" width="463" height="380" />
              </a>

              {/* Background card */}
              <div
                class={`hidden md:block absolute ${service.reverse ? 'left-0' : 'right-0'} top-[24px] w-[676px] h-[393px] rounded-[5px]`}
                style={`background-color: ${service.bgColor};`}
              />

              {/* Text Content */}
              <div
                class={`w-full md:w-[460px] ${service.reverse ? 'md:mr-[90px]' : 'md:ml-[90px]'} relative z-10 md:bg-transparent p-6 md:p-0 rounded-[5px] md:rounded-none`}
                style={`background-color: ${service.bgColor};`}
              >
                <h2 class="font-['Playfair_Display'] font-bold text-[24px] md:text-[32px] mb-[22px]" style={`color: ${service.textColor};`}>
                  {service.title}
                </h2>
                <p class="font-['Montserrat'] font-normal text-[16px] mb-6" style={`color: ${service.textColor};`}>
                  {service.description}
                </p>
                <a
                  href={`/${service.slug}`}
                  class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#007ec5] text-white font-['Montserrat'] font-bold text-[16px] rounded-[5px] hover:bg-[#006ba8] transition-colors shadow-md hover:shadow-lg"
                >
                  Learn More
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
