---
// ReviewsSection.astro - homepage testimonial block, ported from Sergey's
// Figma design (Premium Review Block, v2 export) without React or the
// Figma Make wrapper. Look kept one to one: cream background, Playfair
// heading, large photo on the left, giant quote mark, five stars, the
// quote in Montserrat, author with an avatar and a Google Review line,
// round prev and next arrows.
//
// Behavior kept from the previous block: all slides ship in the dom at
// build time, one visible at a time, 0.2s opacity fades, arrows plus a
// five second autoplay that restarts after a manual click. The left
// photo, the quote and the author fade together.

interface ReviewItem {
  text: string;
  author: string;
  image: string;
  avatar: string | null;
}

interface Props {
  reviews?: ReviewItem[];
}

const { reviews: reviewsProp } = Astro.props;

const fallbackReviews: ReviewItem[] = [
  {
    text: "Alex did a phenomenal job on our kitchen remodel!! He works fast and is meticulous. He really cares about the quality of his work and the satisfaction of his clients. We are so pleased with how our cabinets turned out!",
    author: "Jessee Baldwin",
    image: "https://lh3.googleusercontent.com/geougc-cs/ABOP9puAoW__oTiEGY6ZeLDuTYSqAe-gvO8-ftLlqSZg0X04HjX6-EDXDxUTzAFwcWsoZuivzJQi1u73jnPk6LlE9ySlx8VJSJElfXlbJiWEvdPiCT2ETqrIE7yGvvfGevBYS81ROulb33MkjLpI=s800-w800-h400-rw",
    avatar: "https://lh3.googleusercontent.com/a-/ALV-UjU0OBEXbB-sb4fy3hdc2P9tYhCG5HiiG5h91CTo-ha7McvJLUE=w200-h200-p-rp-mo-ba3-br100",
  },
  {
    text: "Alexander Biriuk built our kitchen cabinets. The results were spectacular, stunning and completed with such care. Alexander is a pleasure to work with and no surprises.",
    author: "Jeffrey Lang",
    image: "https://lh3.googleusercontent.com/geougc-cs/ABOP9ptVDYHT5Vr_k5PUZU8HRjIXZpckIl8GskfK46pIvo5AuZhOjGCIGudEyLCA48WG-CmmPFWZ6glWdzO-uoxzZFqdNUcCijZ3T6UM4S6olUi9Eu1iLzxfzCiNjStZBvAq5bN_xfgn=s800-w800-h400-rw",
    avatar: "https://lh3.googleusercontent.com/a-/ALV-UjW1Q-Qwa8PGarLPIFJL2Ne1iZgdYp5vQoaIBBNRnHpVc8EfjP-d=w72-h72-p-rp-mo-br100",
  },
  {
    text: "We cannot recommend Alex highly enough! From start to finish, he was an absolute pleasure to work with, professional, detail-oriented, and truly passionate about his craft. He installed our kitchen with such precision and care, making sure every detail was perfect.",
    author: "Xenia V.",
    image: "https://lh3.googleusercontent.com/geougc-cs/ABOP9ptDCeBRqKoavCkcrvltzLyEUQec8WuNrcyERtW54jpiTOiV82uYbDc2hrkMsyMHmPalgyx3zDbIMKFr4sNJLDbxRX8pcnWAYrxLWHzYwTJNIS5Mirbk-1iiCYCH_3Xav1UuR6PXAw=s800-w800-h400-rw",
    avatar: "https://lh3.googleusercontent.com/a-/ALV-UjX4A-NawzgEDRuXGp02sv7GSlvdLyrAab8GBg44ABpwGDvPSzZq=w72-h72-p-rp-mo-ba3-br100",
  },
];

const reviews: ReviewItem[] = (reviewsProp && reviewsProp.length > 0) ? reviewsProp : fallbackReviews;

// The photo frame never goes empty: a review without its own photo keeps
// the first available one.
const firstImage = reviews.find((r) => r.image)?.image || "";
const slides = reviews.map((r) => ({ ...r, image: r.image || firstImage }));
---

<section class="w-full py-12 md:py-16 lg:py-20 bg-[#F4EFEA] text-stone-800">
  <div class="rs-root max-w-[1150px] mx-auto px-4 md:px-8">
    <div class="mb-12 md:mb-16">
      <h2 class="font-['Playfair_Display'] font-semibold tracking-tight text-3xl md:text-5xl text-stone-900">
        What Our Clients Say
      </h2>
    </div>

    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-24 items-start">
      {/* Left: large photo, one slide visible */}
      <div class="w-full aspect-[4/3] lg:aspect-[4/5] rounded-xl overflow-hidden shadow-sm relative bg-stone-200">
        {slides.map((r, i) => (
          <img
            data-rs-img={i}
            src={r.image}
            alt={`Photo from ${r.author}'s review`}
            loading={i === 0 ? "eager" : "lazy"}
            class="w-full h-full object-cover absolute inset-0"
            style={`opacity:${i === 0 ? 1 : 0}; transition: opacity .2s ease;`}
          />
        ))}
      </div>

      {/* Right: testimonial content */}
      <div class="flex flex-col h-full justify-center py-4 lg:py-12">
        <div class="flex gap-6 md:gap-8">
          {/* Giant quote mark */}
          <div class="shrink-0 text-[#E0CEC0] pt-1">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 md:w-16 md:h-16" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
          </div>

          {/* Quote and author */}
          <div class="flex-1">
            <div class="grid">
              {slides.map((r, i) => (
                <div
                  data-rs-slide={i}
                  class="col-start-1 row-start-1 flex flex-col justify-center"
                  style={`opacity:${i === 0 ? 1 : 0}; pointer-events:${i === 0 ? 'auto' : 'none'}; transition: opacity .2s ease;`}
                >
                  <div class="flex gap-1 mb-6">
                    {Array.from({ length: 5 }).map(() => (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="#F2B04E" stroke="#F2B04E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
                      </svg>
                    ))}
                  </div>
                  <p class="text-xl md:text-2xl font-['Montserrat'] text-stone-700 leading-relaxed font-medium mb-10">
                    {r.text}
                  </p>
                </div>
              ))}
            </div>

            <div class="flex flex-wrap items-center justify-between gap-8 mt-12">
              {/* Author info, one slide visible */}
              <div class="grid">
                {slides.map((r, i) => (
                  <div
                    data-rs-author={i}
                    class="col-start-1 row-start-1 flex items-center gap-5"
                    style={`opacity:${i === 0 ? 1 : 0}; transition: opacity .2s ease;`}
                  >
                    {r.avatar ? (
                      <img src={r.avatar} alt={r.author} loading={i === 0 ? "eager" : "lazy"} class="w-16 h-16 rounded-full object-cover shadow-sm" width="64" height="64" />
                    ) : (
                      <div class="w-16 h-16 rounded-full bg-[#007ec5] flex items-center justify-center text-white font-['Montserrat'] font-bold text-[22px] shadow-sm">
                        {r.author.charAt(0)}
                      </div>
                    )}
                    <div>
                      <div class="font-['Montserrat'] font-bold uppercase tracking-wider text-sm text-stone-900 mb-1">
                        {r.author}
                      </div>
                      <div class="flex items-center gap-1.5 text-sm font-['Montserrat'] text-stone-500 font-medium">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="16" height="16" aria-hidden="true">
                          <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                          <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                          <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                          <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                        </svg>
                        Google Review
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              {/* Navigation arrows */}
              <div class="flex gap-3">
                <button
                  type="button"
                  data-rs-prev
                  aria-label="Previous review"
                  class="w-12 h-12 flex items-center justify-center rounded-full border border-stone-300 text-stone-500 hover:bg-stone-200/50 hover:text-stone-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-400"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button
                  type="button"
                  data-rs-next
                  aria-label="Next review"
                  class="w-12 h-12 flex items-center justify-center rounded-full border border-stone-300 text-stone-500 hover:bg-stone-200/50 hover:text-stone-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-400"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function init() {
      document.querySelectorAll('.rs-root').forEach(function (root) {
        var imgs = root.querySelectorAll('[data-rs-img]');
        var slides = root.querySelectorAll('[data-rs-slide]');
        var authors = root.querySelectorAll('[data-rs-author]');
        var prev = root.querySelector('[data-rs-prev]');
        var next = root.querySelector('[data-rs-next]');
        if (!imgs.length || !slides.length) return;

        var total = slides.length;
        var current = 0;
        var timer;

        function show(list, i, on) {
          if (!list[i]) return;
          list[i].style.opacity = on ? '1' : '0';
          if (list === slides) list[i].style.pointerEvents = on ? 'auto' : 'none';
        }
        function go(to) {
          var was = current;
          current = ((to % total) + total) % total;
          [imgs, slides, authors].forEach(function (list) {
            show(list, was, false);
            show(list, current, true);
          });
        }
        function nextFn() { go(current + 1); }
        function prevFn() { go(current - 1); }
        function restart() {
          clearInterval(timer);
          timer = setInterval(nextFn, 5000);
        }

        if (next) next.addEventListener('click', function () { nextFn(); restart(); });
        if (prev) prev.addEventListener('click', function () { prevFn(); restart(); });

        timer = setInterval(nextFn, 5000);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
