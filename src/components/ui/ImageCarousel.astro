---
// ImageCarousel.astro - simple fade-through carousel using Astro's <Image>
// for automatic responsive sizing and proper density variants.
//
// To avoid stealing bandwidth from the LCP image, all slides after the first
// are deferred via lazy loading AND the fade-cycle interval doesn't start
// until the carousel enters the viewport. While the carousel is offscreen
// the browser leaves bandwidth for hero/critical content.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface CarouselSlide {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: CarouselSlide[];
  link: string;
  interval?: number;
}

const { images, link, interval = 4000 } = Astro.props;
---

<a
  href={link}
  class="ic-root w-full md:w-[463px] h-[280px] md:h-[380px] rounded-[5px] overflow-hidden shrink-0 relative z-10 hover:opacity-95 transition-opacity block"
  data-ic-interval={interval}
>
  {images.map((s, i) => (
    <Image
      data-ic-slide
      src={s.src}
      alt={s.alt}
      width={463}
      height={380}
      densities={[1, 2]}
      sizes="(min-width: 768px) 463px, 100vw"
      loading="lazy"
      class="w-full h-full object-cover absolute inset-0 transition-opacity duration-1000"
      style={`opacity:${i === 0 ? 1 : 0};`}
    />
  ))}
</a>

<script is:inline>
  (function () {
    function start(root) {
      var slides = root.querySelectorAll('[data-ic-slide]');
      if (slides.length < 2) return;
      if (root.dataset.icStarted === '1') return;
      root.dataset.icStarted = '1';
      var intervalMs = parseInt(root.getAttribute('data-ic-interval'), 10) || 4000;
      var i = 0;
      setInterval(function () {
        slides[i].style.opacity = '0';
        i = (i + 1) % slides.length;
        slides[i].style.opacity = '1';
      }, intervalMs);
    }
    function init() {
      var roots = document.querySelectorAll('.ic-root');
      if (!roots.length) return;
      if (!('IntersectionObserver' in window)) {
        // Fallback: start everything immediately for ancient browsers.
        roots.forEach(start);
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            start(e.target);
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: '200px' });
      roots.forEach(function (root) { io.observe(root); });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

