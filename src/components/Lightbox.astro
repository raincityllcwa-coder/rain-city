---
// Lightbox.astro
// The single photo lightbox for the whole site, included once in Layout.astro.
// Do not add it to individual pages, that would duplicate the #lb element.
//
// Two ways photos get in:
//
// 1. Auto-attach: any <img> inside a Tailwind aspect-ratio container or inside
//    .magazine-grid, excluding images wrapped in <a> (those stay navigation
//    links). All matches on the page form one navigable sequence. This is the
//    project case-study behavior.
//
// 2. Gallery API for scripts: window.__lightbox.open(items, startIndex) where
//    items is an array of URL strings or objects
//    { src, hiRes?, thumb?, alt?, title?, description? }.
//    ProjectsSection uses this for its per-project galleries with captions.
//
// Features: prev/next, arrow keys, Esc, backdrop/image click to close, touch
// swipe, counter, optional caption (title + description), neighbor preload,
// automatic hi-res upgrade for Sanity CDN URLs.
---

<div id="lb" class="lb" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lb-close" type="button" aria-label="Close">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="lb-counter" id="lb-counter">1 / 1</div>

  <button class="lb-prev" type="button" aria-label="Previous photo">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <button class="lb-next" type="button" aria-label="Next photo">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <div class="lb-stage">
    <img id="lb-img" src="" alt="" />
    <div class="lb-spinner" id="lb-spinner" aria-hidden="true"></div>
  </div>

  <div class="lb-caption is-hidden" id="lb-caption">
    <h3 class="lb-caption-title" id="lb-caption-title"></h3>
    <p class="lb-caption-desc" id="lb-caption-desc"></p>
  </div>
</div>

<style is:global>
  .lb {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    user-select: none;
    touch-action: pan-y;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .lb.is-open {
    display: flex;
    opacity: 1;
  }
  .lb-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 70px 80px 110px;
    box-sizing: border-box;
  }
  .lb.no-caption .lb-stage {
    padding-bottom: 70px;
  }
  .lb-stage img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    cursor: zoom-out;
    transition: opacity 0.15s ease;
  }
  .lb-stage img.is-loading {
    opacity: 0.5;
  }
  .lb-spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border: 3px solid rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    animation: lb-spin 0.8s linear infinite;
    opacity: 0;
    pointer-events: none;
  }
  .lb-spinner.is-visible {
    opacity: 1;
  }
  @keyframes lb-spin {
    to { transform: rotate(360deg); }
  }
  .lb-caption {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    width: min(720px, calc(100% - 32px));
    text-align: center;
    pointer-events: none;
    z-index: 10;
  }
  .lb-caption.is-hidden {
    display: none;
  }
  .lb-caption-title {
    font-family: "Playfair Display", serif;
    font-weight: 700;
    font-size: 22px;
    color: #fff;
    margin: 0 0 6px;
    line-height: 1.3;
  }
  .lb-caption-desc {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    line-height: 1.5;
  }
  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 12px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.15s;
    z-index: 10;
    -webkit-tap-highlight-color: transparent;
  }
  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .lb-close:active,
  .lb-prev:active,
  .lb-next:active {
    transform: scale(0.92);
  }
  .lb-close {
    top: 20px;
    right: 20px;
  }
  .lb-prev {
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev:active {
    transform: translateY(-50%) scale(0.92);
  }
  .lb-next {
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next:active {
    transform: translateY(-50%) scale(0.92);
  }
  .lb-counter {
    position: absolute;
    top: 28px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.85);
    font-family: "Montserrat", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    z-index: 10;
    pointer-events: none;
  }
  .lb-prev.is-hidden,
  .lb-next.is-hidden,
  .lb-counter.is-hidden {
    display: none;
  }
  body.lb-locked {
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .lb-stage {
      padding: 56px 8px 96px;
    }
    .lb.no-caption .lb-stage {
      padding-bottom: 56px;
    }
    .lb-caption {
      bottom: 16px;
    }
    .lb-caption-title {
      font-size: 17px;
    }
    .lb-caption-desc {
      font-size: 12px;
    }
    .lb-prev {
      left: 6px;
      padding: 8px;
    }
    .lb-next {
      right: 6px;
      padding: 8px;
    }
    .lb-prev svg,
    .lb-next svg {
      width: 22px;
      height: 22px;
    }
    .lb-close {
      top: 12px;
      right: 12px;
      padding: 10px;
    }
    .lb-counter {
      top: 18px;
      font-size: 13px;
    }
  }
</style>

<script is:inline>
  (function () {
    function initLightbox() {
      var lb = document.getElementById("lb");
      if (!lb || lb.dataset.ready === "1") return;
      lb.dataset.ready = "1";

      var lbImg = document.getElementById("lb-img");
      var counter = document.getElementById("lb-counter");
      var spinner = document.getElementById("lb-spinner");
      var caption = document.getElementById("lb-caption");
      var captionTitle = document.getElementById("lb-caption-title");
      var captionDesc = document.getElementById("lb-caption-desc");
      var btnClose = lb.querySelector(".lb-close");
      var btnPrev = lb.querySelector(".lb-prev");
      var btnNext = lb.querySelector(".lb-next");

      var items = [];
      var currentIndex = 0;

      // Sanity CDN: bump width to 1800 and drop crop params for the overlay.
      function getHiRes(src) {
        if (!src || src.indexOf("cdn.sanity.io") === -1) return src;
        var url = src.split("?")[0];
        var params = {};
        if (src.indexOf("?") !== -1) {
          src.split("?")[1].split("&").forEach(function (p) {
            var kv = p.split("=");
            if (kv[0]) params[kv[0]] = kv[1];
          });
        }
        params.w = "1800";
        delete params.h;
        delete params.fit;
        params.fm = params.fm || "webp";
        params.q = params.q || "85";
        var qs = Object.keys(params)
          .map(function (k) { return k + "=" + params[k]; })
          .join("&");
        return url + "?" + qs;
      }

      function normalize(list) {
        return (list || []).map(function (it) {
          if (typeof it === "string") it = { src: it };
          return {
            src: it.src,
            thumb: it.thumb || null,
            hiRes: it.hiRes || getHiRes(it.src),
            alt: it.alt || "",
            title: it.title || "",
            description: it.description || "",
          };
        }).filter(function (it) { return !!it.src; });
      }

      function showSpinner() { spinner.classList.add("is-visible"); }
      function hideSpinner() { spinner.classList.remove("is-visible"); }
      function doneLoading() {
        lbImg.classList.remove("is-loading");
        hideSpinner();
      }

      function render(index) {
        currentIndex = index;
        var it = items[index];
        if (!it) return;

        lbImg.classList.add("is-loading");
        showSpinner();
        lbImg.alt = it.alt || it.title || "";

        var target = it.hiRes || it.src;
        if (it.thumb && it.thumb !== target) {
          // Paint the already-loaded page thumbnail instantly, then swap in hi-res.
          lbImg.src = it.thumb;
          var loader = new Image();
          loader.onload = function () {
            if (currentIndex === index) { lbImg.src = target; doneLoading(); }
          };
          loader.onerror = doneLoading;
          loader.src = target;
        } else {
          lbImg.src = target;
          if (lbImg.complete && lbImg.naturalWidth > 0) {
            doneLoading();
          } else {
            lbImg.onload = doneLoading;
            lbImg.onerror = doneLoading;
          }
        }

        counter.textContent = index + 1 + " / " + items.length;
        counter.classList.toggle("is-hidden", items.length <= 1);
        btnPrev.classList.toggle("is-hidden", items.length <= 1);
        btnNext.classList.toggle("is-hidden", items.length <= 1);

        var hasCaption = !!(it.title || it.description);
        caption.classList.toggle("is-hidden", !hasCaption);
        lb.classList.toggle("no-caption", !hasCaption);
        captionTitle.textContent = it.title || "";
        captionTitle.style.display = it.title ? "" : "none";
        captionDesc.textContent = it.description || "";
        captionDesc.style.display = it.description ? "" : "none";

        preload((index + 1) % items.length);
        preload((index - 1 + items.length) % items.length);
      }

      function preload(index) {
        if (items.length < 2) return;
        var it = items[index];
        if (!it) return;
        var im = new Image();
        im.src = it.hiRes || it.src;
      }

      function openWith(list, startIndex) {
        var normalized = normalize(list);
        if (!normalized.length) return;
        items = normalized;
        lb.classList.add("is-open");
        lb.setAttribute("aria-hidden", "false");
        document.body.classList.add("lb-locked");
        render(Math.min(Math.max(startIndex || 0, 0), items.length - 1));
      }

      function close() {
        lb.classList.remove("is-open");
        lb.setAttribute("aria-hidden", "true");
        document.body.classList.remove("lb-locked");
        setTimeout(function () {
          lbImg.src = "";
          doneLoading();
        }, 250);
      }

      function next() { render((currentIndex + 1) % items.length); }
      function prev() { render((currentIndex - 1 + items.length) % items.length); }

      // Public API for scripts (ProjectsSection galleries etc).
      window.__lightbox = { open: openWith, close: close };

      // Auto-attach: aspect-ratio containers plus the magazine grid on case
      // studies; images inside links keep working as links.
      var pageImgs = Array.prototype.slice
        .call(document.querySelectorAll('[class*="aspect-["] img, [class*="aspect-square"] img, [class*="aspect-video"] img, .magazine-grid img'))
        .filter(function (img, i, arr) {
          if (arr.indexOf(img) !== i) return false;
          if (img.closest("a")) return false;
          if (!img.src || img.src.indexOf("data:") === 0) return false;
          return true;
        });

      if (pageImgs.length) {
        var autoItems = pageImgs.map(function (img) {
          var src = img.currentSrc || img.src;
          return { src: src, thumb: src, hiRes: getHiRes(src), alt: img.alt || "" };
        });
        pageImgs.forEach(function (img, i) {
          img.style.cursor = "zoom-in";
          img.addEventListener("click", function (e) {
            e.preventDefault();
            openWith(autoItems, i);
          });
        });
      }

      // Close on backdrop or image click. Buttons handle themselves.
      lb.addEventListener("click", function (e) {
        if (e.target.closest(".lb-prev") || e.target.closest(".lb-next") || e.target.closest(".lb-close")) {
          return;
        }
        close();
      });

      btnClose.addEventListener("click", function (e) { e.stopPropagation(); close(); });
      btnPrev.addEventListener("click", function (e) { e.stopPropagation(); prev(); });
      btnNext.addEventListener("click", function (e) { e.stopPropagation(); next(); });

      document.addEventListener("keydown", function (e) {
        if (!lb.classList.contains("is-open")) return;
        if (e.key === "Escape") close();
        else if (e.key === "ArrowLeft") prev();
        else if (e.key === "ArrowRight") next();
      });

      var touchStartX = 0;
      var touchStartY = 0;
      lb.addEventListener("touchstart", function (e) {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });
      lb.addEventListener("touchend", function (e) {
        var dx = e.changedTouches[0].screenX - touchStartX;
        var dy = e.changedTouches[0].screenY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx > 0) prev();
          else next();
        }
      }, { passive: true });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLightbox);
    } else {
      initLightbox();
    }
  })();
</script>
