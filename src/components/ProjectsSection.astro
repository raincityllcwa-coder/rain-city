---
// ProjectsSection.astro - grid of project cards on homepage / service pages.
// Renders all projects at build time but only first 6 are visible; "View More"
// reveals 3 at a time. A card with a slug is a plain link to its case page
// (/our-projects/<slug>): sends visitors and link equity to the case studies
// instead of trapping photos in an overlay. Only slugless projects (including
// the hardcoded fallback set) keep the Lightbox gallery, since they have no
// page of their own to open.

import imgProjectImage from "@/assets/3b944e1ac697f301b31561de640dda3557f43d69.webp";
import imgProjectImage1 from "@/assets/1a9ff41667e1b1a100603f9ba342b2a853274b6f.webp";
import imgProjectImage2 from "@/assets/e1d045053d612f0796a40f57ca1c648d52fa7407.webp";
import imgMoreButton from "@/assets/3b437988bfed0d43dea56bac02897e2e85c27e71.webp";

interface ProjectItem {
  image: string;
  imageAlt?: string | null;
  title: string;
  description: string;
  gallery: string[];
  slug?: string | null;
}

interface Props {
  projects?: ProjectItem[];
}

const { projects: projectsProp } = Astro.props;

const fallbackProjects: ProjectItem[] = [
  { image: imgProjectImage.src,  title: "Kitchen in Bellevue",   description: "Kitchen cabinets design and installation.",                       gallery: [imgProjectImage.src,  imgProjectImage1.src, imgProjectImage2.src] },
  { image: imgProjectImage1.src, title: "Kitchen in Kirkland",   description: "Full kitchen renovation, flooring, appliances installation.",    gallery: [imgProjectImage1.src, imgProjectImage.src,  imgProjectImage2.src] },
  { image: imgProjectImage2.src, title: "Kitchen in Seattle",    description: "Kitchen cabinets design and installation, countertop installation.", gallery: [imgProjectImage2.src, imgProjectImage1.src, imgProjectImage.src]  },
  { image: imgProjectImage.src,  title: "Bathroom in Redmond",   description: "Complete bathroom renovation with modern fixtures.",              gallery: [imgProjectImage.src,  imgProjectImage2.src, imgProjectImage1.src] },
  { image: imgProjectImage1.src, title: "Kitchen in Sammamish",  description: "Custom kitchen cabinets and quartz countertops.",                 gallery: [imgProjectImage1.src, imgProjectImage.src,  imgProjectImage2.src] },
  { image: imgProjectImage2.src, title: "Bathroom in Tacoma",    description: "Luxury bathroom remodel with heated floors.",                     gallery: [imgProjectImage2.src, imgProjectImage.src,  imgProjectImage1.src] },
];

const allProjects: ProjectItem[] = (projectsProp && projectsProp.length > 0) ? projectsProp : fallbackProjects;
const INITIAL_VISIBLE = 6;

// Serialize the per-project galleries into a JSON island the script can read,
// keyed by index. Avoids data-attr noise on each card.
// Escape "<" so content like "</script>" in a title or description cannot
// terminate the JSON island's script tag early.
const galleryData = JSON.stringify(
  allProjects.map((p) => ({ title: p.title, description: p.description, gallery: p.gallery }))
).replace(/</g, "\\u003c");
---

<section id="projects" class="w-full py-12 md:py-16 lg:py-20">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8">
    <h2 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[32px] text-black mb-8 md:mb-11">
      Our Projects
    </h2>

    <div class="ps-root flex flex-col gap-[52px] items-center">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-[24px] w-full">
        {allProjects.map((project, index) => project.slug ? (
          <a
            href={`/our-projects/${project.slug}`}
            data-ps-card={index}
            class={`ps-card group flex flex-col gap-[21px] text-left ${index >= INITIAL_VISIBLE ? 'hidden' : ''}`}
          >
            <div class="w-full h-[240px] md:h-[279px] rounded-[5px] overflow-hidden">
              <img
                src={project.image}
                alt={project.imageAlt || project.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <h3 class="font-['Playfair_Display'] font-bold text-[22px] md:text-[24px] text-[#051e2a] group-hover:text-[#007ec5] transition-colors">
              {project.title}
            </h3>
            <p class="font-['Montserrat'] font-normal text-[16px] text-black">
              {project.description}
            </p>
            <span class="font-['Montserrat'] font-semibold text-[15px] text-[#007ec5] group-hover:underline">
              Read the full project →
            </span>
          </a>
        ) : (
          <div
            data-ps-card={index}
            class={`ps-card flex flex-col gap-[21px] text-left ${index >= INITIAL_VISIBLE ? 'hidden' : ''}`}
          >
            <button
              type="button"
              data-ps-gallery={index}
              aria-label={`Open photo gallery: ${project.title}`}
              class="block w-full h-[240px] md:h-[279px] rounded-[5px] overflow-hidden cursor-zoom-in"
            >
              <img
                src={project.image}
                alt={project.imageAlt || project.title}
                loading="lazy"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              />
            </button>
            <h3 class="font-['Playfair_Display'] font-bold text-[22px] md:text-[24px] text-[#051e2a]">
              {project.title}
            </h3>
            <p class="font-['Montserrat'] font-normal text-[16px] text-black">
              {project.description}
            </p>
          </div>
        ))}
      </div>

      {allProjects.length > INITIAL_VISIBLE && (
        <button
          type="button"
          data-ps-more
          class="bg-white border border-[#989898] rounded-[5px] h-[55px] px-[30px] flex items-center gap-[14px] hover:bg-gray-50 transition-colors"
        >
          <img src={imgMoreButton.src} alt="" class="size-[21px] object-cover" width="21" height="21" />
          <span class="font-['Montserrat'] font-normal text-[16px] text-black">View More</span>
        </button>
      )}

      <a href="/our-projects" class="font-['Montserrat'] font-semibold text-[16px] text-[#007ec5] hover:underline">
        View All Projects →
      </a>
    </div>
  </div>

  {/* Hidden gallery data island */}
  <script type="application/json" data-ps-data set:html={galleryData}></script>
</section>

<script is:inline>
  (function () {
    function init() {
      var section = document.getElementById('projects');
      if (!section) return;
      var dataEl = section.querySelector('[data-ps-data]');
      if (!dataEl) return;
      var data;
      try { data = JSON.parse(dataEl.textContent || '[]'); } catch (e) { return; }
      if (!data.length) return;

      // ── View More ──
      var more = section.querySelector('[data-ps-more]');
      var cards = section.querySelectorAll('[data-ps-card]');
      var INITIAL = 6;
      var STEP = 3;
      var visible = INITIAL;

      function refreshMore() {
        if (!more) return;
        if (visible >= cards.length) {
          more.style.display = 'none';
        }
      }
      if (more) {
        more.addEventListener('click', function () {
          var end = Math.min(visible + STEP, cards.length);
          for (var i = visible; i < end; i++) cards[i].classList.remove('hidden');
          visible = end;
          refreshMore();
        });
        refreshMore();
      }

      // ── Gallery: delegate to the shared Lightbox (Lightbox.astro in Layout) ──
      // Bound to the photo button only; the title and "Read the full project"
      // links navigate to the case page instead of opening the lightbox.
      var galleryBtns = section.querySelectorAll('[data-ps-gallery]');
      galleryBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var idx = parseInt(btn.getAttribute('data-ps-gallery'), 10);
          var p = data[idx];
          if (isNaN(idx) || !p || !window.__lightbox) return;
          var items = (p.gallery || []).map(function (src) {
            return { src: src, title: p.title, description: p.description };
          });
          if (items.length) window.__lightbox.open(items, 0);
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
