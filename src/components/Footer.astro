---
import { getSite } from '@/lib/site';
import { getNavigation, resolveNavItems } from "@/lib/navigation";
const year = new Date().getFullYear();

// Footer columns from Sanity (Navigation document), with the built-in lists as fallback.
const nav = await getNavigation();
const footerServices = await resolveNavItems(nav?.footerServices);
const footerCities = await resolveNavItems(nav?.footerCities);

const serviceAreas = [
  "Bellevue, WA",
  "Seattle, WA",
  "Kirkland, WA",
  "Redmond, WA",
  "Sammamish, WA",
  "Newcastle, WA",
  "Woodinville, WA",
  "Bothell, WA",
  "Mercer Island, WA",
  "Yarrow Point, WA",
  "Medina, WA",
];
const site = await getSite();
---

<footer class="w-full py-8 md:py-12 bg-[#051e2a] text-white">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-6">
      <!-- Brand + Address -->
      <div class="flex flex-col gap-[7px] text-center md:text-left">
        <p class="font-['Playfair_Display'] font-bold text-[24px] md:text-[30px] text-white uppercase">
          Rain City
        </p>
        <div class="h-[1px] bg-white opacity-40 w-full"></div>
        <p class="font-['Montserrat'] font-normal text-[16px] md:text-[20px] text-white">
          Kitchen & Bath
        </p>
        <div class="mt-3">
          <p class="font-['Montserrat'] font-normal text-[13px] md:text-[14px] text-white opacity-80">
            10900 NE 4th St Unit 2300
          </p>
          <p class="font-['Montserrat'] font-normal text-[13px] md:text-[14px] text-white opacity-80">
            Bellevue, WA 98004
          </p>
          <a href={site.phoneHref} class="font-['Montserrat'] font-medium text-[14px] md:text-[15px] text-white opacity-90 hover:opacity-100 transition-opacity mt-2 inline-block">
            {site.phone}
          </a>
          <p class="font-['Montserrat'] font-normal text-[12px] md:text-[13px] text-white opacity-70 mt-2">
            Licensed, Bonded and Insured Washington State General Contractor.<br />
            License #{site.licenseNumber}
          </p>
          <div class="mt-4 flex justify-center md:justify-start">
            <a
              href="https://www.instagram.com/alex_biriuk/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow Rain City Kitchen & Bath on Instagram"
              class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-white/30 text-white opacity-80 hover:opacity-100 hover:bg-white/10 transition"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="flex flex-col gap-3 text-center md:text-left">
        <h3 class="font-['Montserrat'] font-semibold text-[16px] md:text-[18px] mb-1">
          Quick Links
        </h3>
        <a href="/" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">Home</a>
        <a href="/our-services" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">Our Services</a>
        <a href="/our-projects" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">Projects</a>
        <a href="/about" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">About Us</a>
        <a href="/contact" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">Contact</a>
      </div>

      <!-- Services -->
      <div class="flex flex-col gap-3 text-center md:text-left">
        <h3 class="font-['Montserrat'] font-semibold text-[16px] md:text-[18px] mb-1">
          Services
        </h3>
        {footerServices.length > 0 ? footerServices.map((l) => (
          <a href={l.href} class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">{l.label}</a>
        )) : (
          <>
            <a href="/kitchen-cabinets" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">Kitchen Renovation & Cabinets</a>
            <a href="/kitchen-countertops" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">Kitchen Countertops</a>
            <a href="/bathroom-remodel" class="font-['Montserrat'] font-normal text-[14px] md:text-[16px] opacity-80 hover:opacity-100 transition-opacity">Bathroom Remodel</a>
          </>
        )}
      </div>

      <!-- Service Area -->
      <div class="flex flex-col gap-3 text-center md:text-left items-center md:items-start">
        <h3 class="font-['Montserrat'] font-semibold text-[16px] md:text-[18px] mb-1">
          Service Area
        </h3>
        <div class="flex flex-col gap-0.5 items-center md:items-start">
          {footerCities.length > 0 ? footerCities.map((l) => (
            <a href={l.href} class="font-['Montserrat'] font-normal text-[13px] opacity-70 hover:opacity-100 transition-opacity whitespace-nowrap">{l.label}</a>
          )) : serviceAreas.map((city) => (
            <span class="font-['Montserrat'] font-normal text-[13px] opacity-70 whitespace-nowrap">{city}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-white/20 text-center">
      <p class="font-['Montserrat'] font-normal text-[14px] opacity-70">
        © {year} Rain City Kitchen & Bath. All rights reserved.
      </p>
    </div>
  </div>
</footer>
