---
import ImageCarousel from "./ui/ImageCarousel.astro";
import { getDocById } from "../lib/queries";
import { urlFor } from "../lib/sanity";

// Kitchen Cabinets: 5 photos
import imgKc01 from "@/assets/kitchen-cabinets/kc-01.webp";
import imgKc02 from "@/assets/kitchen-cabinets/kc-02.webp";
import imgKc03 from "@/assets/kitchen-cabinets/kc-03.webp";
import imgKc04 from "@/assets/kitchen-cabinets/kc-04.webp";
import imgKc05 from "@/assets/kitchen-cabinets/kc-05.webp";

// Kitchen Countertops: 10 photos
import imgCt01 from "@/assets/kitchen-countertops/ct-01.webp";
import imgCt02 from "@/assets/kitchen-countertops/ct-02.webp";
import imgCt03 from "@/assets/kitchen-countertops/ct-03.webp";
import imgCt04 from "@/assets/kitchen-countertops/ct-04.webp";
import imgCt05 from "@/assets/kitchen-countertops/ct-06.webp";
import imgCt06 from "@/assets/kitchen-countertops/ct-07.webp";
import imgCt07 from "@/assets/kitchen-countertops/ct-08.webp";
import imgCt08 from "@/assets/kitchen-countertops/ct-11.webp";
import imgCt09 from "@/assets/kitchen-countertops/ct-12.webp";
import imgCt10 from "@/assets/kitchen-countertops/ct-13.webp";

// Bathroom Remodel: 10 photos
import imgBr01 from "@/assets/bathroom-remodel/br-16.webp";
import imgBr02 from "@/assets/bathroom-remodel/br-14.webp";
import imgBr03 from "@/assets/bathroom-remodel/br-07.webp";
import imgBr04 from "@/assets/bathroom-remodel/br-09.webp";
import imgBr05 from "@/assets/bathroom-remodel/br-13.webp";
import imgBr06 from "@/assets/bathroom-remodel/br-12.webp";
import imgBr07 from "@/assets/bathroom-remodel/br-03.webp";
import imgBr08 from "@/assets/bathroom-remodel/br-01.webp";
import imgBr09 from "@/assets/bathroom-remodel/br-05.webp";
import imgBr10 from "@/assets/bathroom-remodel/br-15.webp";

const kitchenCabinetsImages = [
  { src: imgKc01, alt: "White Shaker kitchen cabinets with gold hardware installed in Bellevue WA" },
  { src: imgKc02, alt: "White kitchen cabinets with double oven and subway tile backsplash" },
  { src: imgKc03, alt: "Modern flat panel kitchen cabinets with quartz countertop installation" },
  { src: imgKc04, alt: "Gray concrete-style kitchen cabinets with pendant lighting Bellevue" },
  { src: imgKc05, alt: "Gray Shaker cabinets with stainless steel appliances kitchen remodel" },
];

const kitchenCountertopsImages = [
  { src: imgCt01, alt: "Quartz waterfall island countertop in modern kitchen Bellevue WA" },
  { src: imgCt02, alt: "White quartz countertop with waterfall edge and dark cabinets" },
  { src: imgCt03, alt: "Marble-look quartz countertops with gray Shaker cabinets Seattle" },
  { src: imgCt04, alt: "Gray kitchen with quartz island countertop and smart refrigerator" },
  { src: imgCt05, alt: "White quartz countertop island with pendant lights Kirkland WA" },
  { src: imgCt06, alt: "Quartz countertop with arabesque tile backsplash and coffee bar" },
  { src: imgCt07, alt: "Quartz island countertop with bar stools and gold pendant lights" },
  { src: imgCt08, alt: "White Shaker cabinets with marble countertop and island Redmond WA" },
  { src: imgCt09, alt: "Super white quartzite countertop kitchen remodel with dark tile floor" },
  { src: imgCt10, alt: "Gray marble countertop island with fireplace accent wall kitchen renovation" },
];

const bathroomRemodelImages = [
  { src: imgBr01, alt: "Luxury bathroom vanity with LED mirrors and gold hardware Bellevue WA" },
  { src: imgBr02, alt: "Modern dark bathroom remodel with skylight and pebble shower floor" },
  { src: imgBr03, alt: "Marble tile bathroom with glass shower and white vanity Seattle" },
  { src: imgBr04, alt: "Double vanity bathroom remodel with quartz top and crystal lighting" },
  { src: imgBr05, alt: "Walk-in shower with decorative tile and rain showerhead Bellevue" },
  { src: imgBr06, alt: "Bathroom renovation with marble vanity and pebble accent wall" },
  { src: imgBr07, alt: "Glass enclosed shower with subway tile and black fixtures Kirkland" },
  { src: imgBr08, alt: "Black shower panel system with gray porcelain tile bathroom remodel" },
  { src: imgBr09, alt: "Marble tile walk-in shower with mosaic accent strip and hexagon floor" },
  { src: imgBr10, alt: "Custom tile shower with glass door and hexagon floor Redmond WA" },
];

const services = [
  { images: kitchenCabinetsImages, link: "/kitchen-cabinets", title: "Kitchen Renovation & Cabinets", color: "#051e2a", bg: "#f7f6f1", text: "As a leading kitchen remodeling company in Bellevue and Seattle, we specialize in custom kitchen cabinets to meet your unique needs. Our clients can choose from a variety of styles and colors, with Shaker and Flat door styles remaining the most popular for kitchen renovation in 2026.", reverse: false },
  { images: kitchenCountertopsImages, link: "/kitchen-countertops", title: "Kitchen Countertops", color: "#051e2a", bg: "#f1f3f7", text: "We offer a wide variety of natural stone countertops, including dolomite, granite, marble, quartzite, schist, and soapstone, available in different styles, colors, and thicknesses. Our kitchen remodeling services include delivery, precise fabrication, and professional installation across Bellevue, Kirkland, Redmond, and the Eastside.", reverse: true },
  { images: bathroomRemodelImages, link: "/bathroom-remodel", title: "Bathroom Remodel", color: "#051e2a", bg: "#f7f6f1", text: "Looking for bathroom remodeling services near you? Transform your bathroom with our high-quality materials, including porcelain tile, natural stone, or glass tile. We offer a wide range of styles and finishes to create the perfect look for your space.", reverse: false },
];

const shared = await getDocById('copy-shared');
const cards = shared?.serviceCards || [];
// Carousel photos live in their own Studio document "Carousel Photos (Homepage)"
// (id carousel-photos): three photo grids, one per card. If a grid has photos,
// they replace the built-in local set entirely; an empty grid keeps the local set.
const carousel = await getDocById('carousel-photos');
const gridKeys = ['cabinets', 'countertops', 'bathroom'];
services.forEach((s, i) => {
  if (cards[i]?.title) s.title = cards[i].title;
  if (cards[i]?.text) s.text = cards[i].text;
  // Transitional fallback: until the photos are migrated into carousel-photos,
  // keep reading the previous location (serviceCards[i].photos).
  const uploaded = ((carousel?.[gridKeys[i]]?.length ? carousel[gridKeys[i]] : cards[i]?.photos) || [])
    .filter((p: any) => p?.asset);
  if (uploaded.length > 0) {
    s.images = uploaded.map((p: any) => ({
      src: urlFor(p).width(926).height(760).fit("crop").format("webp").quality(80).url(),
      alt: p.alt || s.title,
    }));
  }
});
---

<section id="services" class="w-full py-12 md:py-16 lg:py-20">
  <div class="max-w-[1150px] mx-auto px-4 md:px-8">
    <h2 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[32px] text-black mb-8 md:mb-11">{shared?.servicesHeading || "Kitchen Remodeling & Bathroom Renovation Services"}</h2>
    <div class="flex flex-col gap-12 md:gap-[68px]">
      {services.map((s) => (
        <div class="relative">
          <div class={`flex flex-col ${s.reverse ? 'md:flex-row-reverse' : 'md:flex-row'} gap-6 md:gap-0 items-center`}>
            <ImageCarousel images={s.images} link={s.link} />
            <div class={`hidden md:block absolute ${s.reverse ? 'left-0' : 'right-0'} top-[24px] w-[676px] h-[393px] rounded-[5px]`} style={`background:${s.bg}`}></div>
            <div class={`w-full md:w-[460px] ${s.reverse ? 'md:mr-[90px]' : 'md:ml-[90px]'} relative z-10 p-6 md:p-0 rounded-[5px] md:rounded-none`} style={`background:${s.bg}`}>
              <h3 class="font-['Playfair_Display'] font-bold text-[20px] md:text-[24px] mb-[22px]" style={`color:${s.color}`}>{s.title}</h3>
              <p class="font-['Montserrat'] font-normal text-[16px] text-black">{s.text}</p>
              <a href={s.link} class="inline-block mt-4 py-3 font-['Montserrat'] font-semibold text-[15px] text-[#007ec5] hover:underline">Learn More →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
