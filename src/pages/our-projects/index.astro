---
import Layout from "../../layouts/Layout.astro";
import { getAllProjects } from "../../lib/queries";
import { urlFor } from "../../lib/sanity";

const projects = await getAllProjects();

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Our Recent Kitchen and Bathroom Remodeling Projects",
  "description": "Completed kitchen and bathroom remodels across Bellevue, Seattle, Kirkland, Redmond, and the Eastside.",
  "url": "https://raincityllc.com/our-projects",
  "publisher": {
    "@type": "Organization",
    "name": "Rain City Kitchen & Bath",
    "url": "https://raincityllc.com"
  },
  "hasPart": projects.map((p: any) => ({
    "@type": "Article",
    "headline": p.title,
    "url": `https://raincityllc.com/our-projects/${p.slug?.current}`,
    "image": p.mainImage ? urlFor(p.mainImage).width(800).format("webp").url() : undefined
  }))
};
---

<Layout
  title="Kitchen and Bathroom Remodeling Projects in Seattle Area | Rain City Kitchen & Bath"
  description="Browse our completed kitchen and bathroom remodels across Bellevue, Seattle, Kirkland, Redmond, and the Eastside. Custom-designed and built by Rain City Kitchen & Bath."
  jsonLd={collectionJsonLd}
>
  <!-- Page Header + Intro -->
  <section class="w-full">
    <div class="max-w-[1150px] mx-auto px-4 md:px-8 pt-12 md:pt-16 pb-8 md:pb-12">
      <h1 class="font-['Lora'] font-bold text-[32px] md:text-[42px] lg:text-[46px] text-black leading-tight mb-5 max-w-[820px]">
        Our Recent Kitchen and Bathroom Remodeling Projects
      </h1>
      <p class="font-['Montserrat'] text-[17px] md:text-[18px] text-gray-700 leading-relaxed max-w-[820px]">
        Browse our completed kitchen and bathroom remodels across Bellevue, Seattle, Kirkland, Redmond, and the Eastside.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="w-full">
    <div class="max-w-[1150px] mx-auto px-4 md:px-8 pb-16 md:pb-20">
      {projects.length === 0 ? (
        <p class="font-['Montserrat'] text-[16px] text-gray-600 py-8">No projects published yet. Check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
          {projects.map((p: any) => {
            const slug = p.slug?.current;
            if (!slug) return null;
            const imgUrl = p.mainImage
              ? urlFor(p.mainImage).width(800).height(600).fit("crop").format("webp").url()
              : "";
            return (
              <a href={`/our-projects/${slug}`} class="group block">
                <div class="aspect-[4/3] rounded-[5px] overflow-hidden bg-gray-200 mb-4">
                  {imgUrl && (
                    <img
                      src={imgUrl}
                      alt={p.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      width="800"
                      height="600"
                    />
                  )}
                </div>
                <h2 class="font-['Lora'] font-bold text-[20px] text-black leading-snug mb-2 group-hover:text-[#007ec5] transition-colors">
                  {p.title}
                </h2>
                {(p.city || p.completedYear) && (
                  <p class="font-['Montserrat'] text-[13px] text-gray-500">
                    {p.city}{p.city && p.completedYear ? " · " : ""}{p.completedYear}
                  </p>
                )}
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Layout>
