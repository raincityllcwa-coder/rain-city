---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getAllProjectSlugs, getProjectBySlug } from "../../lib/queries";
import { urlFor } from "../../lib/sanity";

export async function getStaticPaths() {
  const slugs = await getAllProjectSlugs();
  return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = await getProjectBySlug(slug as string);

if (!project) {
  return Astro.redirect("/our-projects");
}

// Determine if this is a full case study (has intro + goals)
const hasCaseStudy = !!(project.intro && project.goals && project.goals.length > 0);

// Helper to get image URL at given width
const img = (src: any, w: number, h?: number) => {
  let b = urlFor(src).width(w).format("webp");
  if (h) b = b.height(h).fit("crop");
  return b.url();
};

// Photo layout:
// - mainImage = hero, rendered full-width at top
// - introPhotos / goalsPhotos / designDecisionsPhotos / beforeAfterPhotos =
//   process-photo groups, rendered immediately after their matching text section
// - finalGallery = showcase gallery of finished space, rendered at the very end
// - If finalGallery is empty, fall back to `gallery` (legacy field, also used
//   by services pages) so existing projects without the new field still show
//   their finished photos at the end.
const heroPhoto = project.mainImage || null;
const finalGalleryPhotos =
  (project.finalGallery && project.finalGallery.length > 0)
    ? project.finalGallery
    : (project.gallery && project.gallery.length > 0 ? project.gallery : []);

// Render a text field as paragraphs (blank lines = paragraph breaks).
// Returns an HTML string for use with set:html. Empty input returns empty string.
// Text is escaped first: without it a literal "<" in Sanity copy (e.g.
// "budget <10k") swallows the rest of the paragraph, and Studio content
// becomes an HTML injection vector.
const escapeText = (s: string): string =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const paragraphs = (text: string | null | undefined): string => {
  if (!text || !text.trim()) return "";
  return text
    .split("\n\n")
    .map((p) => p.trim())
    .filter(Boolean)
    .map((p) => `<p>${escapeText(p)}</p>`)
    .join("");
};

// Pick a grid that doesn't look lonely for 1-2 photos and doesn't get cramped for 3+.
function gridColsFor(count: number): string {
  if (count === 1) return "grid-cols-1 max-w-[820px] mx-auto";
  if (count === 2) return "grid-cols-1 md:grid-cols-2";
  return "grid-cols-1 md:grid-cols-2 lg:grid-cols-3";
}

// Build the page title. Google cuts <title> at roughly 60 characters / 580 pixels.
// If the project title is already long, appending the brand pushes us well past
// the cut-off ("Complete Kitchen Remodel in South Seattle: ..." + " | Rain City
// Kitchen & Bath" = 107 chars and the brand half gets clipped anyway).
// So only append the brand when the project title is short enough to fit.
const RAW_TITLE = project.title || "";
const BRAND_SUFFIX = " | Rain City Kitchen & Bath";
const pageTitle =
  project.metaTitle ||
  (RAW_TITLE.length + BRAND_SUFFIX.length <= 65
    ? RAW_TITLE + BRAND_SUFFIX
    : RAW_TITLE);

// Description should stay near 150 chars for Google's snippet. Trim cleanly at a
// word boundary so we don't end mid-word.
function trimDesc(text: string, max = 155): string {
  if (text.length <= max) return text;
  const slice = text.slice(0, max);
  const lastSpace = slice.lastIndexOf(" ");
  return (lastSpace > 80 ? slice.slice(0, lastSpace) : slice).trimEnd();
}

const pageDescription = trimDesc(
  project.metaDescription
    || (project.intro ? project.intro.replace(/\s+/g, " ") : project.description)
    || ""
);

// Article JSON-LD
const articleJsonLd = hasCaseStudy
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": project.title,
      "description": pageDescription,
      "image": heroPhoto ? [img(heroPhoto, 1600)] : [],
      "datePublished": project._createdAt,
      "dateModified": project._updatedAt,
      "author": {
        "@type": "Organization",
        "name": "Rain City Kitchen & Bath",
        "url": "https://raincityllc.com",
      },
      "publisher": {
        "@type": "Organization",
        "name": "Rain City Kitchen & Bath",
        "logo": {
          "@type": "ImageObject",
          "url": "https://raincityllc.com/og-default.jpg",
        },
      },
      "about": {
        "@type": "Service",
        "serviceType": "Kitchen Remodeling",
        "areaServed": project.city
          ? { "@type": "Place", "name": project.city }
          : undefined,
      },
    }
  : null;

const breadcrumbItems = [
  { name: "Home", href: "/" },
  { name: "Projects", href: "/our-projects" },
  { name: project.title },
];

const combinedJsonLd = articleJsonLd ? articleJsonLd : null;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={combinedJsonLd ?? undefined}
  canonical={`https://raincityllc.com/our-projects/${slug}`}
  ogImage={heroPhoto ? img(heroPhoto, 1200, 630) : undefined}
>
  <Breadcrumbs items={breadcrumbItems} />

  {/* Hero Photo */}
  {heroPhoto && (
    <section class="w-full">
      <div class="max-w-[1150px] mx-auto px-4 md:px-8 pt-8 md:pt-12">
        <div class="w-full aspect-[16/9] rounded-[5px] overflow-hidden bg-gray-200">
          <img
            src={img(heroPhoto, 1600)}
            alt={project.title}
            class="w-full h-full object-cover"
            fetchpriority="high"
            width="1600"
            height="900"
          />
        </div>
      </div>
    </section>
  )}

  {/* Article Header */}
  <section class="w-full">
    <div class="max-w-[820px] mx-auto px-4 md:px-8 pt-8 md:pt-10">
      {hasCaseStudy && (
        <p class="font-['Montserrat'] text-[14px] text-[#007ec5] font-semibold uppercase tracking-wider mb-4">Featured Project</p>
      )}
      <h1 class="font-['Playfair_Display'] font-bold text-[32px] md:text-[42px] lg:text-[46px] text-black leading-tight mb-6">
        {project.title}
      </h1>
      {project.description && (
        <p class="font-['Montserrat'] text-[18px] text-gray-700 leading-relaxed mb-8">
          {project.description}
        </p>
      )}

      {(project.city || project.completedYear) && (
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8 py-6 border-t border-b border-gray-200">
          {project.city && (
            <div>
              <p class="font-['Montserrat'] text-[12px] text-gray-500 uppercase tracking-wider mb-1">Location</p>
              <p class="font-['Montserrat'] font-semibold text-[15px] text-black">{project.city}</p>
            </div>
          )}
          <div>
            <p class="font-['Montserrat'] text-[12px] text-gray-500 uppercase tracking-wider mb-1">Project Type</p>
            <p class="font-['Montserrat'] font-semibold text-[15px] text-black">{hasCaseStudy ? "Full Remodel" : "Project"}</p>
          </div>
          {project.completedYear && (
            <div>
              <p class="font-['Montserrat'] text-[12px] text-gray-500 uppercase tracking-wider mb-1">Completed</p>
              <p class="font-['Montserrat'] font-semibold text-[15px] text-black">{project.completedYear}</p>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  {hasCaseStudy ? (
    <>
      {/* CASE STUDY LAYOUT */}

      {/* Section 1: Intro */}
      <article class="w-full">
        <div class="max-w-[820px] mx-auto px-4 md:px-8 pt-8 md:pt-12 article-prose">
          {project.intro && <div set:html={paragraphs(project.intro)} />}
        </div>
      </article>

      {/* Photos after Intro */}
      {project.introPhotos && project.introPhotos.length > 0 && (
        <section class="w-full my-8 md:my-10">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8">
            <div class={`grid ${gridColsFor(project.introPhotos.length)} gap-4 md:gap-5`}>
              {project.introPhotos.map((p: any, i: number) => (
                <div class="aspect-[4/3] rounded-[5px] overflow-hidden bg-gray-200">
                  <img src={img(p, 900)} alt={`${project.title} intro photo ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Section 2: Goals */}
      {project.goals && project.goals.length > 0 && (
        <article class="w-full">
          <div class="max-w-[820px] mx-auto px-4 md:px-8 article-prose">
            <h2>{project.goalsHeading || "The Project Goals"}</h2>
            {project.goalsIntro && <div set:html={paragraphs(project.goalsIntro)} />}
            <ol>
              {project.goals.map((g: string) => (<li>{g}</li>))}
            </ol>
            {project.goalsOutro && <div set:html={paragraphs(project.goalsOutro)} />}
          </div>
        </article>
      )}

      {/* Photos after Goals */}
      {project.goalsPhotos && project.goalsPhotos.length > 0 && (
        <section class="w-full my-8 md:my-10">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8">
            <div class={`grid ${gridColsFor(project.goalsPhotos.length)} gap-4 md:gap-5`}>
              {project.goalsPhotos.map((p: any, i: number) => (
                <div class="aspect-[4/3] rounded-[5px] overflow-hidden bg-gray-200">
                  <img src={img(p, 900)} alt={`${project.title} demo photo ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Section 3: Design Decisions */}
      {project.designDecisions && project.designDecisions.length > 0 && (
        <article class="w-full">
          <div class="max-w-[820px] mx-auto px-4 md:px-8 article-prose">
            <h2>{project.designDecisionsHeading || "The Design Choices That Made the Space Work"}</h2>
            {project.designDecisionsIntro && <div set:html={paragraphs(project.designDecisionsIntro)} />}
            {project.designDecisions.map((d: any) => (
              <>
                <h3>{d.heading}</h3>
                <div set:html={paragraphs(d.body)} />
              </>
            ))}
          </div>
        </article>
      )}

      {/* Photos after Design Decisions: magazine-style asymmetric layout */}
      {project.designDecisionsPhotos && project.designDecisionsPhotos.length > 0 && (
        <section class="w-full my-10 md:my-14">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8">
            <div class="magazine-grid">
              {project.designDecisionsPhotos.map((p: any, i: number) => (
                <div class="rounded-[5px] overflow-hidden bg-gray-200">
                  <img src={img(p, 1200)} alt={`${project.title} construction photo ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Before/After Table */}
      {project.beforeAfter && project.beforeAfter.length > 0 && (
        <section class="w-full bg-[#f7f6f1] py-12 md:py-16 my-12 md:my-16">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8">
            <h2 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[32px] text-black mb-6 text-center">{project.beforeAfterHeading || "What We Replaced and Upgraded"}</h2>
            {project.beforeAfterIntro && (
              <div class="article-prose mb-8 max-w-[820px] mx-auto" set:html={paragraphs(project.beforeAfterIntro)} />
            )}
            <div class="bg-white rounded-[5px] overflow-hidden border border-gray-200">
              <div class="overflow-x-auto">
                <table class="w-full font-['Montserrat'] text-[14px] md:text-[15px]">
                  <thead>
                    <tr class="bg-[#051e2a] text-white">
                      <th class="text-left p-4 font-semibold">Item</th>
                      <th class="text-left p-4 font-semibold">Before</th>
                      <th class="text-left p-4 font-semibold">After</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-200">
                    {project.beforeAfter.map((row: any, i: number) => (
                      <tr class={i % 2 === 1 ? "bg-gray-50" : ""}>
                        <td class="p-4 font-semibold">{row.item}</td>
                        <td class="p-4 text-gray-600">{row.before}</td>
                        <td class="p-4">{row.after}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* Photos after Before / After */}
      {project.beforeAfterPhotos && project.beforeAfterPhotos.length > 0 && (
        <section class="w-full my-8 md:my-10">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8">
            <div class={`grid ${gridColsFor(project.beforeAfterPhotos.length)} gap-4 md:gap-5`}>
              {project.beforeAfterPhotos.map((p: any, i: number) => (
                <div class="aspect-[4/3] rounded-[5px] overflow-hidden bg-gray-200">
                  <img src={img(p, 900)} alt={`${project.title} finishes photo ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Section 4: Result */}
      {project.resultText && (
        <article class="w-full">
          <div class="max-w-[820px] mx-auto px-4 md:px-8 article-prose">
            <h2>{project.resultHeading || "The Result"}</h2>
            <div set:html={paragraphs(project.resultText)} />
          </div>
        </article>
      )}

      {/* Final Result Gallery (separate showcase at the end) */}
      {finalGalleryPhotos.length > 0 && (
        <section class="w-full bg-[#f7f6f1] py-12 md:py-16 mt-12 md:mt-16">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8">
            <h2 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[36px] text-[#051e2a] mb-2 text-center">
              {project.finalGalleryHeading || "The Finished Space"}
            </h2>
            <p class="font-['Montserrat'] text-[14px] text-gray-500 text-center mb-10">Click any photo to view full size</p>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
              {finalGalleryPhotos.map((p: any, i: number) => (
                <div class="aspect-[4/3] rounded-[5px] overflow-hidden bg-gray-200 shadow-sm hover:shadow-md transition-shadow">
                  <img src={img(p, 1000)} alt={`${project.title} finished photo ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* CTA Section */}
      <section class="w-full bg-[#051e2a] py-12 md:py-16 mt-12 md:mt-16">
        <div class="max-w-[820px] mx-auto px-4 md:px-8 text-center">
          <h2 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[36px] text-white mb-4 leading-tight">
            Thinking About a Kitchen or Bathroom Remodel?
          </h2>
          <p class="font-['Montserrat'] text-[16px] md:text-[18px] text-white/85 leading-relaxed mb-8 max-w-[640px] mx-auto">
            Rain City Kitchen & Bath serves Seattle, Bellevue, Kirkland, Redmond, and the surrounding Eastside. Free in-home consultation, no obligation.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="inline-flex items-center justify-center bg-[#007ec5] hover:bg-[#006ba8] text-white font-['Montserrat'] font-bold text-[16px] px-8 py-4 rounded-[5px] transition-colors">
              Get Your Free Estimate
            </a>
            <a href="/our-projects" class="inline-flex items-center justify-center bg-transparent hover:bg-white/10 text-white border border-white/40 font-['Montserrat'] font-semibold text-[16px] px-8 py-4 rounded-[5px] transition-colors">
              See More Projects
            </a>
          </div>
          <p class="font-['Montserrat'] text-[13px] text-white/60 mt-8">
            Licensed and insured · WA Contractor License #BIRIUCL808C6
          </p>
        </div>
      </section>
    </>
  ) : (
    <>
      {/* GALLERY-ONLY LAYOUT (project without case study text) */}
      {finalGalleryPhotos.length > 0 && (
        <section class="w-full">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8 py-10 md:py-12">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
              {finalGalleryPhotos.map((p: any, i: number) => (
                <div class="aspect-[4/3] rounded-[5px] overflow-hidden bg-gray-200">
                  <img src={img(p, 800, 600)} alt={`${project.title} photo ${i + 1}`} class="w-full h-full object-cover" loading="lazy" width="800" height="600" />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="w-full bg-[#f7f6f1] py-12 md:py-16">
        <div class="max-w-[820px] mx-auto px-4 md:px-8 text-center">
          <a href="/our-projects" class="inline-flex items-center gap-2 font-['Montserrat'] font-semibold text-[16px] text-[#007ec5] hover:underline">
            ← Back to All Projects
          </a>
        </div>
      </section>
    </>
  )}

</Layout>

<style is:global>
  .article-prose p { font-size: 16px; line-height: 1.7; color: #1a1a1a; margin-bottom: 1.25em; font-family: 'Montserrat', sans-serif; }
  .article-prose h2 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 28px; color: #051e2a; margin-top: 2.5em; margin-bottom: 0.8em; line-height: 1.25; }
  .article-prose h3 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 22px; color: #051e2a; margin-top: 2em; margin-bottom: 0.6em; }
  .article-prose ol { counter-reset: list-counter; padding-left: 0; margin: 1.5em 0; list-style: none; }
  .article-prose ol li { counter-increment: list-counter; position: relative; padding-left: 2.5rem; margin-bottom: 0.85em; font-size: 16px; line-height: 1.6; font-family: 'Montserrat', sans-serif; }
  .article-prose ol li::before { content: counter(list-counter); position: absolute; left: 0; top: 0; width: 1.75rem; height: 1.75rem; background: #007ec5; color: white; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 13px; }
  @media (max-width: 768px) {
    .article-prose h2 { font-size: 24px; }
    .article-prose h3 { font-size: 20px; }
  }

  /*
   * Magazine-style grid for the "Photos: After Design Decisions" block.
   * Cycle of 5 photos on a 6-column grid (desktop):
   *   - 1st photo (5n+1): big featured, spans 4 cols x 2 rows
   *   - 2nd photo (5n+2): right-top, spans 2 cols x 1 row
   *   - 3rd photo (5n+3): right-bottom, spans 2 cols x 1 row
   *   - 4th photo (5n+4): wide bottom-left, spans 3 cols x 1 row
   *   - 5th photo (5n+5): wide bottom-right, spans 3 cols x 1 row
   * Mobile (under 640px) collapses to a plain 2-column grid for readability.
   * Tablet (640-1023px) reduces to a simpler 4-col pattern.
   */
  .magazine-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 130px;
    gap: 10px;
  }
  .magazine-grid > * {
    grid-column: span 1;
    grid-row: span 1;
  }
  @media (min-width: 640px) {
    .magazine-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 160px;
      grid-auto-flow: dense;
      gap: 14px;
    }
    .magazine-grid > *:nth-child(5n+1) { grid-column: span 3; grid-row: span 2; }
    .magazine-grid > *:nth-child(5n+2) { grid-column: span 1; grid-row: span 1; }
    .magazine-grid > *:nth-child(5n+3) { grid-column: span 1; grid-row: span 1; }
    .magazine-grid > *:nth-child(5n+4) { grid-column: span 2; grid-row: span 1; }
    .magazine-grid > *:nth-child(5n+5) { grid-column: span 2; grid-row: span 1; }
  }
  @media (min-width: 1024px) {
    .magazine-grid {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 200px;
      gap: 16px;
    }
    .magazine-grid > *:nth-child(5n+1) { grid-column: span 4; grid-row: span 2; }
    .magazine-grid > *:nth-child(5n+2) { grid-column: span 2; grid-row: span 1; }
    .magazine-grid > *:nth-child(5n+3) { grid-column: span 2; grid-row: span 1; }
    .magazine-grid > *:nth-child(5n+4) { grid-column: span 3; grid-row: span 1; }
    .magazine-grid > *:nth-child(5n+5) { grid-column: span 3; grid-row: span 1; }
  }
</style>
