---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import HeroForm from '../components/HeroForm.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import LeadFormSection from '../components/LeadFormSection.astro';
import MobileCallButton from '../components/MobileCallButton.astro';
import heroImage from '../assets/f54c0cc7231f70cee3cc02ad5edc8c18c5bbbaf6.webp';
import googleG from '../assets/badges/google-g.png';
import starIcon from '../assets/badges/star.png';
import bestOfBellevue from '../assets/badges/best-of-bellevue.png';

// ── Sanity ──
import { getProjects, getReviews } from '../lib/queries';
import { transformProjects, transformReviews } from '../lib/transforms';

let projectsData: any[] = [];
let reviewsData: any[] = [];

try {
  const [p, r] = await Promise.all([
    getProjects('homepage'),
    getReviews('homepage'),
  ]);
  if (p?.length) projectsData = transformProjects(p);
  if (r?.length) reviewsData = transformReviews(r);
} catch (e) {
  console.warn('[Sanity] Homepage fetch failed:', e);
}

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Rain City Kitchen & Bath",
  "image": "https://raincityllc.com/og-default.jpg",
  "telephone": "(253) 466-8709",
  "url": "https://raincityllc.com",
  "sameAs": [
    "https://www.instagram.com/alex_biriuk/"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "10900 NE 4th St Unit 2300",
    "addressLocality": "Bellevue",
    "addressRegion": "WA",
    "postalCode": "98004",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 47.6101,
    "longitude": -122.2015
  },
  "areaServed": [
    "Bellevue", "Seattle", "Kirkland", "Redmond", "Sammamish",
    "Medina", "Newcastle", "Woodinville", "Yarrow Point", "Bothell", "Mercer Island"
  ],
  "priceRange": "$$",
  "identifier": {
    "@type": "PropertyValue",
    "propertyID": "WA-Contractor-License",
    "value": "BIRIUCL808C6"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "131",
    "bestRating": "5",
    "worstRating": "1"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "09:00",
      "closes": "15:00"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Kitchen & Bath Remodeling Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Remodel Bellevue WA" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Renovation & Cabinets" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Countertops Installation" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Bathroom Remodeling Services" }}
    ]
  }
};
---

<Layout
  title="Kitchen Remodel Bellevue WA | Bathroom Remodeling Services | Rain City Kitchen & Bath"
  description="Top-rated kitchen remodeling company in Bellevue, WA. Kitchen renovation, cabinets, countertops & bathroom remodeling services near me. 5-star rated, 131+ reviews. Free estimate."
  jsonLd={localBusinessJsonLd}
>
  <!-- Hero Section -->
  <section id="home" class="relative w-full">
    <div class="absolute inset-0 min-h-full">
      {/* Single responsive Image: Astro generates 400/600/800/1200/1600/2000
          width variants. The browser picks the smallest that fills 100vw.
          A 400-wide phone now pulls ~25KB instead of the previous 47KB
          mobile-source PSI flagged. */}
      <Image
        src={heroImage}
        alt="Kitchen remodel in Bellevue WA by Rain City Kitchen & Bath"
        widths={[400, 600, 800, 1200, 1600, 2000]}
        sizes="100vw"
        quality={75}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative max-w-[1150px] mx-auto px-4 md:px-8 py-8 md:py-[37px] w-full min-h-[600px] md:min-h-[630px] flex items-center">
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-[100px] items-center justify-between w-full">
        <div class="flex flex-col gap-[12px] md:gap-[15px] w-full lg:w-[500px] text-center lg:text-left">
          <h1 class="font-['Lora'] font-bold text-[28px] md:text-[36px] lg:text-[42px] text-white leading-tight">Premium Kitchen & Bath Remodeling Company in Bellevue, WA</h1>
          <p class="font-['Montserrat'] font-normal text-[16px] md:text-[18px] text-white">Trusted kitchen remodeling company serving Seattle, Kirkland, Redmond & the Eastside. We provide expert craftsmanship and personalized service for your dream kitchen or bathroom renovation.</p>
          <div class="flex flex-wrap items-center gap-4 justify-center lg:justify-start mt-1">
            <Image src={bestOfBellevue} alt="City of Bellevue" width={90} height={101} loading="lazy" decoding="async" class="w-[52px] h-auto shrink-0" />
            <div class="flex gap-[7px] items-center">
              <Image src={googleG} alt="Google" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
              <Image src={starIcon} alt="5 star rating" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
              <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
              <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
              <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
              <Image src={starIcon} alt="" width={19} height={19} loading="eager" decoding="async" class="w-[19px] h-[19px]" />
              <span class="font-['Montserrat'] font-medium text-[16px] text-white/90 ml-2">5.0 (131 Google Reviews)</span>
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <p class="font-['Montserrat'] font-bold text-[18px] text-white">Bellevue's Top Kitchen & Bath Contractor</p>
            <p class="font-['Montserrat'] font-normal text-[14px] text-white/80">More than 300 projects successfully completed since 2020. Licensed, Bonded and Insured Washington State General Contractor. License #BIRIUCL808C6</p>
          </div>
        </div>
        <HeroForm />
      </div>
    </div>
  </section>

  <ServicesSection />
  <ProjectsSection projects={projectsData.length > 0 ? projectsData : undefined} />
  <ReviewsSection reviews={reviewsData.length > 0 ? reviewsData : undefined} />
  <AboutSection />
  <ProcessSection />
  <LeadFormSection />
  <MobileCallButton />
</Layout>
