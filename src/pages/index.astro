---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import HeroForm from '../components/HeroForm.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import LeadFormSection from '../components/LeadFormSection.astro';
import MobileCallButton from '../components/MobileCallButton.astro';
import googleG from '../assets/badges/google-g.png';
import starIcon from '../assets/badges/star.png';

// ── Sanity ──
import { getProjects, getReviews } from '../lib/queries';
import { transformProjects, transformReviews } from '../lib/transforms';

let projectsData: any[] = [];
let reviewsData: any[] = [];

try {
  const [p, r] = await Promise.all([
    getProjects('homepage'),
    getReviews('homepage'),
  ]);
  if (p?.length) projectsData = transformProjects(p);
  if (r?.length) reviewsData = transformReviews(r);
} catch (e) {
  console.warn('[Sanity] Homepage fetch failed:', e);
}

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Rain City Kitchen & Bath",
  "image": "https://raincityllc.com/og-default.jpg",
  "telephone": "(253) 466-8709",
  "url": "https://raincityllc.com",
  "sameAs": [
    "https://www.instagram.com/alex_biriuk/"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "10900 NE 4th St Unit 2300",
    "addressLocality": "Bellevue",
    "addressRegion": "WA",
    "postalCode": "98004",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 47.6101,
    "longitude": -122.2015
  },
  "areaServed": [
    "Bellevue", "Seattle", "Kirkland", "Redmond", "Sammamish",
    "Medina", "Newcastle", "Woodinville", "Yarrow Point", "Bothell", "Mercer Island"
  ],
  "priceRange": "$$",
  "identifier": {
    "@type": "PropertyValue",
    "propertyID": "WA-Contractor-License",
    "value": "BIRIUCL808C6"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "131",
    "bestRating": "5",
    "worstRating": "1"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "09:00",
      "closes": "15:00"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Kitchen & Bath Remodeling Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Remodel Bellevue WA" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Renovation & Cabinets" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Countertops Installation" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Bathroom Remodeling Services" }}
    ]
  }
};
---

<Layout
  title="Kitchen Remodel Bellevue WA | Bathroom Remodeling Services | Rain City Kitchen & Bath"
  description="Top-rated kitchen remodeling company in Bellevue, WA. Kitchen renovation, cabinets, countertops & bathroom remodeling services near me. 5-star rated, 131+ reviews. Free estimate."
  jsonLd={localBusinessJsonLd}
>
  <!-- Hero Section -->
  <section id="home" class="relative w-full">
    <div class="absolute inset-0 overflow-hidden bg-[#847b6f]">
      {/* Raw img (no Astro processing) so the hero photo keeps full quality.
          Mobile shifts the photo up to frame the hood; desktop fills the hero. */}
      <img
        src="/hero-kitchen.webp"
        alt="Bright modern kitchen remodel in Bellevue WA by Rain City Kitchen & Bath"
        width="2048"
        height="1365"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute top-0 left-0 w-full h-[700px] -translate-y-[300px] object-cover [-webkit-mask-image:linear-gradient(to_bottom,#000_92%,transparent_100%)] [mask-image:linear-gradient(to_bottom,#000_92%,transparent_100%)] lg:h-full lg:translate-y-0 lg:[-webkit-mask-image:none] lg:[mask-image:none]"
      />
      {/* Desktop: bottom gradient (headline sits at the bottom there) */}
      <div class="hidden lg:block absolute inset-x-0 bottom-0 h-[65%] pointer-events-none" style="background: linear-gradient(to top, rgba(132,123,111,0.82) 0%, rgba(0,0,0,0.5) 40%, rgba(0,0,0,0) 100%);"></div>
      {/* Mobile: keep the top bright, darken only behind the text, fade into the taupe below */}
      <div class="lg:hidden absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, rgba(0,0,0,0) 0px, rgba(0,0,0,0) 140px, rgba(0,0,0,0.5) 330px, rgba(0,0,0,0.45) 62%, rgba(132,123,111,0.92) 88%, #847b6f 100%);"></div>
    </div>

    <div class="relative max-w-[1150px] mx-auto px-4 md:px-8 pt-40 pb-8 lg:pt-14 lg:pb-12 min-h-[580px] lg:min-h-[680px] flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 lg:gap-10">
      {/* Form: below the text on mobile, right on desktop */}
      <div class="order-2 w-full lg:w-[410px] lg:shrink-0">
        <HeroForm />
      </div>
      {/* Headline + rating: above the form on mobile, bottom-left on desktop */}
      <div class="order-1 flex flex-col gap-[10px] items-start max-w-full lg:max-w-[620px]">
        <h1 class="font-['Playfair_Display'] font-semibold text-[26px] md:text-[30px] lg:text-[32px] text-white leading-tight" style="text-shadow: 0 1px 4px rgba(0,0,0,0.35);">Premium Kitchen &amp; Bath Remodeling Company in Bellevue, WA</h1>
        <p class="font-['Montserrat'] font-medium text-[16px] md:text-[18px] text-white leading-snug" style="text-shadow: 0 1px 4px rgba(0,0,0,0.35);">Trusted kitchen remodeling company serving Seattle, Kirkland, Redmond &amp; the Eastside.<span class="hidden lg:inline"> We provide expert craftsmanship and personalized service for your dream kitchen or bathroom renovation.</span></p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-1">
          <Image src={googleG} alt="Google" width={19} height={19} loading="eager" decoding="async" class="w-[22px] h-[22px]" />
          <span class="font-['Montserrat'] font-medium text-[16px] text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);">5.0 (131 Google Reviews)</span>
          <div class="flex gap-[3px]">
            <Image src={starIcon} alt="5 star rating" width={17} height={17} loading="eager" decoding="async" class="w-[17px] h-[17px] [filter:brightness(0)_invert(1)]" />
            <Image src={starIcon} alt="" width={17} height={17} loading="eager" decoding="async" class="w-[17px] h-[17px] [filter:brightness(0)_invert(1)]" />
            <Image src={starIcon} alt="" width={17} height={17} loading="eager" decoding="async" class="w-[17px] h-[17px] [filter:brightness(0)_invert(1)]" />
            <Image src={starIcon} alt="" width={17} height={17} loading="eager" decoding="async" class="w-[17px] h-[17px] [filter:brightness(0)_invert(1)]" />
            <Image src={starIcon} alt="" width={17} height={17} loading="eager" decoding="async" class="w-[17px] h-[17px] [filter:brightness(0)_invert(1)]" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <ServicesSection />
  <ProjectsSection projects={projectsData.length > 0 ? projectsData : undefined} />
  <ReviewsSection reviews={reviewsData.length > 0 ? reviewsData : undefined} />
  <AboutSection />
  <ProcessSection />
  <LeadFormSection />
  <MobileCallButton />
</Layout>
