---
import Layout from '../layouts/Layout.astro';
import { getHubPage, getHomePage } from '../lib/queries';
import { getTopLevelServices } from '../lib/pages';
import ServiceHero from '../components/services/ServiceHero.astro';
import ServiceDetails from '../components/services/ServiceDetails.astro';
import ServiceBenefits from '../components/services/ServiceBenefits.astro';
import ServiceCTA from '../components/services/ServiceCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MobileCallButton from '../components/MobileCallButton.astro';

// Cards and the JSON-LD list come from the published top-level service pages.
const hub = await getHubPage('services');
// Order follows Home > Featured services; anything not featured goes after.
const home = await getHomePage();
const featuredOrder = (home?.featuredServices || []).map((f: any) => f?._id);
const services = [...(await getTopLevelServices())].sort((x, y) => {
  const ix = featuredOrder.indexOf(x._id);
  const iy = featuredOrder.indexOf(y._id);
  return (ix === -1 ? 999 : ix) - (iy === -1 ? 999 : iy) || x.path.localeCompare(y.path);
});
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Kitchen & Bathroom Remodeling Services",
  "itemListElement": services.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": s.cardTitle || s.title,
      "url": `https://raincityllc.com${s.path}`,
      "description": s.cardShortText || s.subtitle || "",
    },
  })),
};
---

<Layout
  title={hub?.metaTitle || "Our Services - Kitchen Renovation & Cabinets, Countertops, Bathroom | Rain City"}
  description={hub?.metaDescription || "Kitchen cabinets, countertop installation, and bathroom remodeling services in Bellevue, Seattle & surrounding areas. Licensed contractors. Free estimates."}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[
    { name: "Home", href: "/" },
    { name: "Our Services" },
  ]} />
  <ServiceHero title={hub?.title} subtitle={hub?.subtitle} />
  <ServiceDetails services={services} />
  <ServiceBenefits />
  <ServiceCTA />
  <MobileCallButton />
</Layout>
