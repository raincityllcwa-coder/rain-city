---
import Layout from '../layouts/Layout.astro';
import { getPageMeta } from '../lib/queries';
import ServiceHero from '../components/services/ServiceHero.astro';
import ServiceDetails from '../components/services/ServiceDetails.astro';
import ServiceBenefits from '../components/services/ServiceBenefits.astro';
import ServiceCTA from '../components/services/ServiceCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MobileCallButton from '../components/MobileCallButton.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Kitchen & Bathroom Remodeling Services",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "Service",
        "name": "Kitchen Renovation & Cabinets",
        "url": "https://raincityllc.com/kitchen-cabinets",
        "description": "Custom and standard kitchen cabinet design and installation. Shaker and Flat door styles."
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "Service",
        "name": "Kitchen Countertops",
        "url": "https://raincityllc.com/kitchen-countertops",
        "description": "Natural stone countertop fabrication and installation: dolomite, granite, marble, quartzite, schist, and soapstone."
      }
    },
    {
      "@type": "ListItem",
      "position": 3,
      "item": {
        "@type": "Service",
        "name": "Bathroom Remodel",
        "url": "https://raincityllc.com/bathroom-remodel",
        "description": "Complete bathroom remodeling with porcelain, natural stone, and glass tile."
      }
    }
  ]
};
const meta = await getPageMeta('our-services');
---

<Layout
  title={meta?.metaTitle || "Our Services - Kitchen Renovation & Cabinets, Countertops, Bathroom | Rain City"}
  description={meta?.metaDescription || "Kitchen cabinets, countertop installation, and bathroom remodeling services in Bellevue, Seattle & surrounding areas. Licensed contractors. Free estimates."}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[
    { name: "Home", href: "/" },
    { name: "Our Services" },
  ]} />
  <ServiceHero />
  <ServiceDetails />
  <ServiceBenefits />
  <ServiceCTA />
  <MobileCallButton />
</Layout>
