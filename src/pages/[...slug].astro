---
// Service pages and city pages from Sanity (types servicePage and cityPage),
// at any depth. Service pages use the full service template (hero with form,
// intro slider, reviews grid, projects, why choose us, process, FAQ, service
// area, lead form). City pages use the simpler template until the Kirkland
// prototype lands. Fixed pages (/, /about, /contact, /our-services,
// /our-projects) always win over a page document with the same URL.
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServiceLandingHero from '../components/services/ServiceLandingHero.astro';
import ServiceContentSection from '../components/services/ServiceContentSection.astro';
import ReviewsGridSection from '../components/services/ReviewsGridSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import WhyChooseUsSection from '../components/WhyChooseUsSection.astro';
import OurProcessSection from '../components/OurProcessSection.astro';
import FAQSection from '../components/FAQSection.astro';
import ServiceAreaSection from '../components/ServiceAreaSection.astro';
import WideLeadFormSection from '../components/WideLeadFormSection.astro';
import MobileCallButton from '../components/MobileCallButton.astro';
import AreasWeServe from '../components/seo/AreasWeServe.astro';
import RelatedServices from '../components/seo/RelatedServices.astro';
import imgServiceHero from '../assets/c4e93df24993f176102d516e4e5e7a4fd86822b6.webp';
import { getAllPages, bodyToHtml, bodyPlainText, type PageDoc } from '../lib/pages';
import { getReviewsForService, getProjectsForService, getReviewsForCity, getProjectsForCity } from '../lib/queries';
import { getSite, postalAddress } from '../lib/site';
import { transformReviews, transformProjects } from '../lib/transforms';
import { urlFor } from '../lib/sanity';

export async function getStaticPaths() {
  // Declared inside: Astro runs getStaticPaths in isolation.
  const STATIC_PATHS = new Set(['/', '/about', '/contact', '/our-services', '/our-projects', '/thanks', '/404']);
  const pages = await getAllPages();
  return pages
    .filter((page) => !STATIC_PATHS.has(page.path) && !page.path.startsWith('/our-projects/'))
    .map((page) => ({ params: { slug: page.path.replace(/^\//, '') }, props: { page } }));
}

const { page } = Astro.props as { page: PageDoc };
const site = await getSite();
const isService = page.pageType === 'service';

function trimDesc(text: string, max = 155): string {
  if (text.length <= max) return text;
  const slice = text.slice(0, max);
  const lastSpace = slice.lastIndexOf(' ');
  return (lastSpace > 80 ? slice.slice(0, lastSpace) : slice).trimEnd();
}

const pageTitle = page.metaTitle || page.title;
// An explicit meta description is used verbatim; only auto-fallbacks are trimmed.
const pageDescription = page.metaDescription || trimDesc(page.subtitle || bodyPlainText(page.body) || '');
const canonical = page.canonicalUrl || `https://raincityllc.com${page.path}`;
const ogImage = page.ogImage?.asset
  ? urlFor(page.ogImage).width(1200).height(630).fit('crop').format('jpg').url()
  : page.heroImage?.asset
    ? urlFor(page.heroImage).width(1200).height(630).fit('crop').format('jpg').url()
    : undefined;

const heroSrc = page.heroImage?.asset ? urlFor(page.heroImage).width(1600).format('webp').quality(80).url() : null;
const heroAlt = page.heroImage?.alt || undefined;
const bodyHtml = bodyToHtml(page.body);
const gallery = (page.gallery || []).filter((p: any) => p?.asset);
const faqItems = page.faqs || [];
const cardName = page.cardTitle || page.title;

// Intro block with the photo slider (service pages).
const sliderImages = (page.sliderPhotos || []).filter((p: any) => p?.asset).map((p: any) => ({
  src: urlFor(p).width(1000).height(760).fit('crop').format('webp').quality(80).url(),
  alt: p.alt || (page.introTitle || ''),
}));
const hasIntro = Boolean(page.introTitle || (page.introParagraphs && page.introParagraphs.length) || sliderImages.length);

// Reviews and projects: service pages show the ones pointing at this page,
// city pages show their own city first, then the homepage set.
let reviewsData: any[] = [];
let projectsData: any[] = [];
try {
  const [r, p] = await Promise.all([
    page.showReviews !== false ? (isService ? getReviewsForService(page._id) : getReviewsForCity(page.cityId)) : [],
    page.showProjects !== false ? (isService ? getProjectsForService(page._id) : getProjectsForCity(page.cityId, page.cityName)) : [],
  ]);
  if (r?.length) reviewsData = transformReviews(r);
  if (p?.length) projectsData = transformProjects(p);
} catch (e) {
  console.warn(`[Sanity] ${page.path} reviews/projects fetch failed:`, e);
}

// Nearby cities: links only when the city already has a published page.
let nearbyLinks: { label: string; href: string }[] = [];
if (!isService && page.nearby?.length) {
  const all = await getAllPages();
  const byCityId = new Map(all.filter((p) => p.pageType === 'city' && !p.noindex && p.cityId).map((p) => [p.cityId as string, p]));
  nearbyLinks = page.nearby
    .filter((c) => c?._id && byCityId.has(c._id) && byCityId.get(c._id)!.path !== page.path)
    .map((c) => ({ label: c.name, href: byCityId.get(c._id)!.path }));
}

// Breadcrumbs from the parent chain (the Our Services hub for top-level services).
const crumbs: { name: string; href?: string }[] = [{ name: 'Home', href: '/' }];
if (page.chain.length === 0 && isService) crumbs.push({ name: 'Services', href: '/our-services' });
for (const a of page.chain) crumbs.push({ name: a.cardTitle || a.title, href: a.path });
crumbs.push({ name: cardName });

// JSON-LD: Service plus FAQPage when there are questions.
const provider = {
  "@type": "LocalBusiness",
  "name": site.companyName,
  "telephone": site.phone,
  "url": "https://raincityllc.com",
  "address": postalAddress(site),
};
const jsonLd: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": cardName,
    "description": pageDescription,
    "url": canonical,
    "provider": provider,
    "areaServed": page.cityName ? { "@type": "City", "name": `${page.cityName}, WA` } : { "@type": "City", "name": "Bellevue, WA" },
    ...(heroSrc ? { "image": heroSrc } : {}),
  },
];
if (faqItems.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((faq) => ({ "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer } })),
  });
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  noindex={page.noindex === true}
  preloadImage={heroSrc || undefined}
>
  <Breadcrumbs items={crumbs} />

  {isService ? (
    <>
      <ServiceLandingHero backgroundImage={heroSrc || imgServiceHero.src} backgroundAlt={heroAlt} title={page.title} subtitle={page.subtitle || ''} />
      {hasIntro && <ServiceContentSection images={sliderImages} title={page.introTitle || ''} paragraphs={page.introParagraphs || []} />}
    </>
  ) : heroSrc ? (
    <section class="relative w-full min-h-[420px] md:min-h-[520px] flex items-center">
      <div class="absolute inset-0">
        <img src={heroSrc} alt={page.heroImage?.alt || page.title} class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
        <div class="absolute inset-0 bg-black/55"></div>
      </div>
      <div class="relative max-w-[1150px] mx-auto px-4 md:px-8 py-16 w-full">
        <h1 class="font-['Playfair_Display'] font-bold text-[30px] md:text-[42px] text-white leading-tight mb-4 max-w-[860px]" style="text-shadow: 0 1px 4px rgba(0,0,0,0.35);">{page.title}</h1>
        {page.subtitle && <p class="font-['Montserrat'] text-[17px] md:text-[19px] text-white/95 max-w-[760px]">{page.subtitle}</p>}
        <a href="#lead-form" class="inline-block mt-8 bg-[#007ec5] hover:bg-[#006ba8] text-white font-['Montserrat'] font-bold text-[16px] px-8 py-4 rounded-[5px] transition-colors">Get Your Free Estimate</a>
      </div>
    </section>
  ) : (
    <section class="w-full bg-[#f7f6f1] py-12 md:py-16">
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        <h1 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[38px] text-[#051e2a] mb-4">{page.title}</h1>
        {page.subtitle && <p class="font-['Montserrat'] text-[16px] md:text-[18px] text-gray-700 max-w-[820px]">{page.subtitle}</p>}
      </div>
    </section>
  )}

  {bodyHtml && (
    <section class="w-full py-10 md:py-14">
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        <div class="max-w-[860px]" set:html={bodyHtml} />
      </div>
    </section>
  )}

  {gallery.length > 0 && (
    <section class="w-full pb-10 md:pb-14">
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {gallery.map((g: any) => (
            <img src={urlFor(g).width(800).height(600).fit('crop').format('webp').quality(80).url()} alt={g.alt || page.title} loading="lazy" class="w-full h-auto rounded-[5px] object-cover" />
          ))}
        </div>
      </div>
    </section>
  )}

  {isService ? (
    <>
      {page.showReviews !== false && <ReviewsGridSection reviews={reviewsData.length > 0 ? reviewsData : undefined} />}
      {page.showProjects !== false && <ProjectsSection projects={projectsData.length > 0 ? projectsData : undefined} />}
      {page.showWhyChooseUs !== false && <WhyChooseUsSection />}
      {page.showProcess !== false && <OurProcessSection />}
      {faqItems.length > 0 && <FAQSection faqs={faqItems} />}
      {page.showServiceArea !== false && <ServiceAreaSection />}
      {page.showAreas !== false && <AreasWeServe currentPath={page.path} />}
      {page.showLeadForm !== false && <WideLeadFormSection />}
    </>
  ) : (
    <>
      {page.showRelatedServices !== false && <RelatedServices currentPath={page.path} />}
      {page.showProjects !== false && projectsData.length > 0 && <ProjectsSection projects={projectsData} />}
      {page.showReviews !== false && reviewsData.length > 0 && <ReviewsGridSection reviews={reviewsData} />}
      {faqItems.length > 0 && <FAQSection faqs={faqItems} />}
      {nearbyLinks.length > 0 && (
        <section class="w-full py-10 md:py-14 bg-[#f7f6f1]">
          <div class="max-w-[1150px] mx-auto px-4 md:px-8">
            <h2 class="font-['Playfair_Display'] font-bold text-[24px] md:text-[28px] text-black mb-6">Nearby Cities</h2>
            <ul class="flex flex-wrap gap-x-6 gap-y-3">
              {nearbyLinks.map((l) => (
                <li><a href={l.href} class="font-['Montserrat'] text-[16px] text-[#051e2a] hover:text-[#007ec5] underline underline-offset-4 decoration-gray-300 hover:decoration-[#007ec5] transition-colors">{l.label}</a></li>
              ))}
            </ul>
          </div>
        </section>
      )}
      {page.showLeadForm !== false && <div id="lead-form"><WideLeadFormSection /></div>}
    </>
  )}
  <MobileCallButton />
</Layout>
