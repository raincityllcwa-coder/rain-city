---
// Dynamic SEO landing pages (service + city), fully managed in Sanity Studio
// as "landingPage" documents. Static routes always win over this dynamic one,
// so existing pages cannot be shadowed. With zero documents the route builds
// nothing. Slugs are root-level to match the existing flat URL structure
// (e.g. /kitchen-renovation-kirkland).
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewsGridSection from '../components/services/ReviewsGridSection.astro';
import FAQSection from '../components/FAQSection.astro';
import WideLeadFormSection from '../components/WideLeadFormSection.astro';
import MobileCallButton from '../components/MobileCallButton.astro';
import { getLandingPages } from '../lib/queries';

export async function getStaticPaths() {
  let pages: any[] = [];
  try {
    pages = (await getLandingPages()) || [];
  } catch (e) {
    console.warn('[Sanity] landingPage fetch failed:', e);
  }
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const slug = Astro.params.slug;

const escapeText = (s: string): string =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const paragraphs = (text: string | null | undefined): string => {
  if (!text || !text.trim()) return "";
  return text
    .split("\n\n")
    .map((p) => p.trim())
    .filter(Boolean)
    .map((p) => `<p class="mb-4">${escapeText(p)}</p>`)
    .join("");
};

function trimDesc(text: string, max = 155): string {
  if (text.length <= max) return text;
  const slice = text.slice(0, max);
  const lastSpace = slice.lastIndexOf(" ");
  return (lastSpace > 80 ? slice.slice(0, lastSpace) : slice).trimEnd();
}

const pageTitle = page.metaTitle || page.h1 || page.title;
const pageDescription = trimDesc(page.metaDescription || page.sections?.[0]?.body?.replace(/\s+/g, " ") || "");

const faqItems = (page.faqs || []).filter((f: any) => f?.question && f?.answer);

const serviceNames: Record<string, string> = {
  "kitchen-renovation": "Kitchen Renovation",
  "kitchen-countertops": "Kitchen Countertops Installation",
  "bathroom-remodel": "Bathroom Remodeling",
};

const jsonLd: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": page.h1 || page.title,
    "description": pageDescription,
    "provider": {
      "@type": "LocalBusiness",
      "name": "Rain City Kitchen & Bath",
      "telephone": "(253) 466-8709",
      "address": { "@type": "PostalAddress", "addressLocality": "Bellevue", "addressRegion": "WA" }
    },
    "areaServed": page.city ? `${page.city}, WA` : "Seattle metropolitan area",
    "serviceType": serviceNames[page.service] || page.service || "Remodeling"
  },
];

if (faqItems.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((faq: any) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
  });
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://raincityllc.com/${slug}`}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[
    { name: "Home", href: "/" },
    { name: page.h1 || page.title },
  ]} />

  <section class="w-full bg-[#f7f6f1] py-12 md:py-16">
    <div class="max-w-[1150px] mx-auto px-4 md:px-8">
      <h1 class="font-['Playfair_Display'] font-bold text-[28px] md:text-[36px] text-[#051e2a] mb-4">{page.h1 || page.title}</h1>
      {page.subtitle && (
        <p class="font-['Montserrat'] text-[16px] md:text-[18px] text-gray-700 max-w-[820px]">{page.subtitle}</p>
      )}
    </div>
  </section>

  {(page.sections || []).map((section: any) => (
    <section class="w-full py-10 md:py-14">
      <div class="max-w-[1150px] mx-auto px-4 md:px-8">
        {section.heading && (
          <h2 class="font-['Playfair_Display'] font-bold text-[24px] md:text-[28px] text-black mb-6">{section.heading}</h2>
        )}
        <div class="font-['Montserrat'] text-[16px] text-black max-w-[860px]" set:html={paragraphs(section.body)} />
      </div>
    </section>
  ))}

  {page.showReviews !== false && <ReviewsGridSection />}
  {faqItems.length > 0 && <FAQSection faqs={faqItems} />}
  {page.showLeadForm !== false && <WideLeadFormSection />}
  <MobileCallButton />
</Layout>
